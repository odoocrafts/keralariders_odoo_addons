<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Portal Record Rules (Seller) -->
        <record id="logistics_seller_portal_rule" model="ir.rule">
            <field name="name">Portal Seller Rule</field>
            <field name="model_id" ref="model_logistics_seller"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_wallet_portal_rule" model="ir.rule">
            <field name="name">Portal Wallet Rule</field>
            <field name="model_id" ref="model_logistics_wallet"/>
            <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_wallet_transaction_portal_rule" model="ir.rule">
            <field name="name">Portal Wallet Transaction Rule</field>
            <field name="model_id" ref="model_logistics_wallet_transaction"/>
            <field name="domain_force">[('wallet_id.seller_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_wallet_recharge_request_portal_rule" model="ir.rule">
            <field name="name">Portal Wallet Recharge Request Rule</field>
            <field name="model_id" ref="model_logistics_wallet_recharge_request"/>
            <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_shipment_portal_rule" model="ir.rule">
            <field name="name">Portal Shipment Rule (Seller)</field>
            <field name="model_id" ref="model_logistics_shipment"/>
            <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Delivery Executive: assigned shipments + own DE record -->
        <record id="logistics_shipment_de_rule" model="ir.rule">
            <field name="name">DE Shipment Rule</field>
            <field name="model_id" ref="model_logistics_shipment"/>
            <field name="domain_force">['|', ('delivery_executive_id.user_id', '=', user.id), ('custodian_de_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_executive'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_de_own_rule" model="ir.rule">
            <field name="name">DE Own Record</field>
            <field name="model_id" ref="model_logistics_delivery_executive"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_executive'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Hub Manager: shipments related to managed hubs -->
        <record id="logistics_shipment_hub_manager_rule" model="ir.rule">
            <field name="name">Hub Manager Shipment Rule</field>
            <field name="model_id" ref="model_logistics_shipment"/>
            <field name="domain_force">['|', '|',
                ('current_hub_id.manager_ids', 'in', [user.id]),
                ('source_hub_id.manager_ids', 'in', [user.id]),
                ('destination_hub_id.manager_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_logistics_hub_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_hub_manager_hub_rule" model="ir.rule">
            <field name="name">Hub Manager Own Hubs</field>
            <field name="model_id" ref="model_logistics_hub"/>
            <field name="domain_force">[('manager_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_logistics_hub_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Events: portal/DE/hub can read related; admin full via ACL -->
        <record id="logistics_shipment_event_portal_rule" model="ir.rule">
            <field name="name">Portal Shipment Event (Seller)</field>
            <field name="model_id" ref="model_logistics_shipment_event"/>
            <field name="domain_force">[('shipment_id.seller_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_shipment_event_de_rule" model="ir.rule">
            <field name="name">DE Shipment Event Rule</field>
            <field name="model_id" ref="model_logistics_shipment_event"/>
            <field name="domain_force">['|', ('shipment_id.delivery_executive_id.user_id', '=', user.id), ('shipment_id.custodian_de_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_logistics_executive'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="logistics_shipment_event_hub_manager_rule" model="ir.rule">
            <field name="name">Hub Manager Shipment Event Rule</field>
            <field name="model_id" ref="model_logistics_shipment_event"/>
            <field name="domain_force">['|', '|',
                ('hub_id.manager_ids', 'in', [user.id]),
                ('shipment_id.current_hub_id.manager_ids', 'in', [user.id]),
                ('shipment_id.source_hub_id.manager_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_logistics_hub_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
