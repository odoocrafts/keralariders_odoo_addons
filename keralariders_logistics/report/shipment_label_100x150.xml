<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_shipping_label_100x150" model="report.paperformat">
        <field name="name">KX Shipping Label 100×150 mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">150</field>
        <!-- wkhtmltopdf swaps these for Landscape, so the sheet is 150×100 mm. -->
        <field name="orientation">Landscape</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="css_margins" eval="False"/>
    </record>

    <template id="report_shipment_document_100x150_label">
        <t t-set="seller_addr" t-value="o._awb_seller_address()"/>
        <t t-set="customer_phone" t-value="o._awb_customer_phone()"/>
        <t t-set="is_ip" t-value="o.fulfilment_method == 'indiapost'"/>
        <t t-set="arn" t-value="o.portal_indiapost_arn() or ''"/>
        <t t-set="item_desc" t-value="o._awb_label_item_description()"/>
        <div class="page kx-label-100x150">
            <!-- One grid. Nested tables were leaving the side rule short of
                 the outer frame and a blank panel under the last row. -->
            <table class="kx-label-sheet">
                <colgroup>
                    <col style="width: 37%"/>
                    <col style="width: 27%"/>
                    <col style="width: 36%"/>
                </colgroup>
                <tr>
                    <td colspan="3" class="kx-label-head">
                        <table>
                            <tr>
                                <td class="kx-label-kx-logo">
                                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="KeralaXpress"/>
                                    <span t-else="" class="kx-label-kx-name">KERALAXPRESS</span>
                                </td>
                                <td class="kx-label-partner-logo">
                                    <img t-if="is_ip" t-att-src="o._awb_indiapost_logo_data_uri()"
                                         class="awb-indiapost-logo"
                                         alt="India Post"/>
                                    <t t-elif="o.seller_id.image_1920">
                                        <img t-att-src="image_data_uri(o.seller_id.image_1920)" alt="Seller"/>
                                    </t>
                                    <strong t-else="" t-field="o.shipping_from_name"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="kx-label-shipto">
                        <div class="kx-label-kicker">SHIP TO</div>
                        <div class="kx-label-shipto-name text-uppercase"><span t-field="o.shipping_to_name"/></div>
                        <div class="kx-label-shipto-addr">
                            <span t-field="o.shipping_to_address"/>
                            <t t-if="o.shipping_to_district_id">, <span t-field="o.shipping_to_district_id"/></t>
                            <t t-if="o.shipping_to_state_id">, <span t-field="o.shipping_to_state_id"/></t>
                        </div>
                        <div class="kx-label-pin">PIN <span t-field="o.shipping_to_zip"/></div>
                        <div t-if="customer_phone" class="kx-label-mob">Mob: <t t-esc="customer_phone"/></div>
                    </td>
                    <td class="kx-label-service">
                        <div class="kx-label-service-mark"><t t-esc="o._awb_label_service_code()"/></div>
                        <div class="kx-label-service-pin" t-field="o.shipping_to_zip"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="kx-label-from">
                        <div class="kx-label-kicker">FROM</div>
                        <div class="text-uppercase kx-label-from-name"><t t-esc="seller_addr['name']"/></div>
                        <div class="kx-label-from-addr">
                            <t t-esc="seller_addr['street']"/>
                            <t t-if="seller_addr['district']">, <t t-esc="seller_addr['district']"/></t>
                            <t t-if="seller_addr['state']">, <t t-esc="seller_addr['state']"/></t>
                        </div>
                        <div>
                            PIN <strong t-esc="seller_addr['zip']"/>
                            <t t-if="seller_addr['phone']"> · Ph <t t-esc="seller_addr['phone']"/></t>
                        </div>
                    </td>
                    <td class="kx-label-scan">
                        <img t-att-src="o._awb_label_top_barcode_img_src()"
                             class="awb-indiapost-barcode"
                             alt="Shipping Barcode"/>
                        <div class="awb-indiapost-article">
                            <t t-if="arn"><span t-esc="arn"/></t>
                            <t t-else="">AWB <span t-field="o.name"/></t>
                        </div>
                        <div t-if="is_ip and o._awb_indiapost_customer_id()" class="awb-customer-id">
                            CUSTOMER ID: <t t-esc="o._awb_indiapost_customer_id()"/>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="kx-label-pay">
                        <t t-if="o.order_payment_type == 'cod'">
                            <div class="kx-label-cod">COD</div>
                            <div class="kx-awb-money"><t t-out="o._awb_format_money(o.cod_amount)"/></div>
                        </t>
                        <t t-else="">
                            <div class="kx-label-prepaid">PREPAID</div>
                        </t>
                    </td>
                    <td class="kx-label-meta">
                        <div><strong>Wt</strong> <span t-field="o.total_weight"/> kg</div>
                        <div><strong>Date</strong> <span t-field="o.order_date" t-options="{'widget': 'date'}"/></div>
                    </td>
                    <td class="kx-label-qr-cell">
                        <img t-att-src="o._awb_label_qr_img_src()"
                             t-attf-class="kx-label-qr{{'' if is_ip else ' kx-label-kx-qr'}}"
                             alt="Tracking QR"/>
                    </td>
                </tr>
                <tr t-if="item_desc">
                    <td colspan="2" class="kx-label-item">
                        <div class="kx-label-item-text"><t t-esc="item_desc"/></div>
                    </td>
                    <td class="kx-label-service-name"><t t-esc="o._awb_label_service_name()"/></td>
                </tr>
                <tr t-if="not item_desc">
                    <td colspan="3" class="kx-label-service-name"><t t-esc="o._awb_label_service_name()"/></td>
                </tr>
                <!-- Hub/DE: full-width KX AWB Code128 along the long edge.
                     India Post already has the ARN barcode above. -->
                <tr t-if="not is_ip">
                    <td colspan="3" class="kx-label-awb-barcode">
                        <img t-att-src="o._awb_kx_barcode_img_src()"
                             class="kx-label-kx-barcode"
                             alt="AWB Barcode"/>
                        <div>AWB <span t-field="o.name"/></div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_shipment_document_100x150">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <style type="text/css">
                <t t-out="docs._awb_money_font_css()"/>
                /* Landscape 100×150. wkhtmltopdf swaps the custom page size
                   when orientation is Landscape, so the sheet is 150×100 mm.
                   Paperformat already applies 3 mm margins; do not add a
                   second @page inset. Usable box is 144×94 mm. */
                @page { size: 150mm 100mm; margin: 0; }
                /* Odoo report CSS sets html/body to height 100% and Bootstrap
                   .container adds padding. Either one pushes a full-bleed
                   label onto a second, mostly blank page. */
                html, body, body.o_body_pdf, body.o_body_html, #wrapwrap, main {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: auto !important;
                    max-width: none !important;
                    height: auto !important;
                    min-height: 0 !important;
                    overflow: visible !important;
                }
                .kx-label-100x150,
                .kx-label-100x150 * {
                    box-sizing: border-box;
                }
                .kx-label-100x150 {
                    color: #000;
                    background: #fff;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 9px;
                    line-height: 1.15;
                    width: 144mm;
                    max-width: 100%;
                    /* Hug the grid. A forced 88 mm table left an empty panel
                       inside the frame and stopped the side rule early.
                       Stay under the 94 mm usable height (100−6). */
                    height: auto;
                    max-height: 94mm;
                    overflow: hidden;
                    page-break-inside: avoid;
                    page-break-after: avoid;
                    page-break-before: auto;
                }
                .kx-label-100x150 + .kx-label-100x150 {
                    page-break-before: always;
                }
                .kx-label-100x150 table {
                    width: 100%;
                    max-width: 100%;
                    border-collapse: collapse;
                    border-spacing: 0;
                    table-layout: fixed;
                }
                .kx-label-100x150 > table {
                    height: auto;
                    border: none;
                }
                .kx-label-100x150 > table > tbody > tr > td,
                .kx-label-100x150 > table > tr > td {
                    border: 2px solid #000;
                    padding: 1mm 1.6mm;
                    vertical-align: middle;
                }
                .kx-label-100x150 .kx-label-head {
                    padding: 0;
                    height: 16mm;
                }
                .kx-label-100x150 .kx-label-head table,
                .kx-label-100x150 .kx-label-head td {
                    border: 0 !important;
                    height: 15mm;
                }
                .kx-label-100x150 .kx-label-kx-logo,
                .kx-label-100x150 .kx-label-partner-logo {
                    width: 50%;
                    padding: 0.8mm 2mm;
                    vertical-align: middle;
                }
                .kx-label-100x150 .kx-label-partner-logo {
                    text-align: right;
                }
                .kx-label-100x150 .kx-label-kx-name {
                    font-size: 11px;
                    font-weight: 900;
                    letter-spacing: 0.4px;
                }
                .kx-label-100x150 .kx-label-kicker {
                    font-size: 6px;
                    font-weight: 700;
                    letter-spacing: 0.4px;
                    margin-bottom: 0.2mm;
                }
                .kx-label-100x150 .kx-label-shipto {
                    vertical-align: top;
                    font-size: 9px;
                }
                .kx-label-100x150 .kx-label-shipto-name {
                    font-size: 12px;
                    font-weight: 900;
                    line-height: 1.25;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                }
                .kx-label-100x150 .kx-label-pin {
                    font-size: 12px;
                    font-weight: 900;
                    margin-top: 0.3mm;
                }
                .kx-label-100x150 .kx-label-mob {
                    font-size: 10px;
                    font-weight: 700;
                }
                .kx-label-100x150 .kx-label-from {
                    vertical-align: top;
                    font-size: 9px;
                }
                .kx-label-100x150 .kx-label-from-name {
                    font-size: 11px;
                    font-weight: 900;
                }
                .kx-label-100x150 .kx-label-service,
                .kx-label-100x150 .kx-label-scan,
                .kx-label-100x150 .kx-label-qr-cell,
                .kx-label-100x150 .kx-label-service-name,
                .kx-label-100x150 .kx-label-pay,
                .kx-label-100x150 .kx-label-awb-barcode {
                    text-align: center;
                }
                .kx-label-100x150 .kx-label-service-mark {
                    border: 2px solid #000;
                    display: inline-block;
                    min-width: 12mm;
                    padding: 0.4mm 1.6mm;
                    font-size: 16px;
                    font-weight: 900;
                    line-height: 1.05;
                    letter-spacing: 1px;
                }
                .kx-label-100x150 .kx-label-service-pin {
                    font-size: 11px;
                    font-weight: 900;
                    margin-top: 0.6mm;
                }
                .kx-label-100x150 .awb-indiapost-article,
                .kx-label-100x150 .awb-customer-id {
                    font-size: 7px;
                    font-weight: 700;
                    margin-top: 0.3mm;
                }
                .kx-label-100x150 .kx-label-cod {
                    font-size: 13px;
                    font-weight: 900;
                    border: 2px solid #000;
                    display: inline-block;
                    padding: 0.4mm 2mm;
                    letter-spacing: 1px;
                }
                .kx-label-100x150 .kx-awb-money {
                    font-size: 11px;
                    font-weight: 700;
                    margin-top: 0.4mm;
                }
                .kx-label-100x150 .kx-label-prepaid {
                    font-size: 13px;
                    font-weight: 900;
                    letter-spacing: 1px;
                }
                .kx-label-100x150 .kx-label-meta {
                    font-size: 8px;
                    text-align: left;
                }
                .kx-label-100x150 .kx-label-service-name {
                    font-size: 9px;
                    font-weight: 900;
                    letter-spacing: 0.3px;
                    text-transform: uppercase;
                }
                .kx-label-100x150 .kx-label-awb-barcode {
                    padding: 0.8mm 2mm;
                }
                .kx-label-100x150 .kx-label-awb-barcode div {
                    font-size: 9px;
                    font-weight: 900;
                    letter-spacing: 1px;
                    margin-top: 0.3mm;
                }
                .kx-label-100x150 img {
                    max-width: 100% !important;
                    max-height: 12mm !important;
                }
                .kx-label-100x150 .kx-label-kx-logo img,
                .kx-label-100x150 .kx-label-partner-logo img {
                    max-height: 12mm !important;
                }
                .kx-label-100x150 .kx-label-qr {
                    width: 12mm !important;
                    height: 12mm !important;
                    max-width: 12mm !important;
                    max-height: 12mm !important;
                }
                .kx-label-100x150 img.kx-label-kx-qr {
                    width: 18mm !important;
                    height: 18mm !important;
                    max-width: 18mm !important;
                    max-height: 18mm !important;
                    image-rendering: -webkit-optimize-contrast;
                }
                .kx-label-100x150 .awb-indiapost-barcode,
                .kx-label-100x150 .kx-label-awb-barcode img {
                    display: block;
                    width: 100%;
                    max-width: 100%;
                    height: 8mm !important;
                    max-height: 8mm !important;
                    margin: 0 auto;
                }
                .kx-label-100x150 .kx-label-awb-barcode img.kx-label-kx-barcode {
                    width: auto !important;
                    max-width: 120mm !important;
                    height: 12mm !important;
                    max-height: 12mm !important;
                }
                /* wkhtmltopdf ignores max-height on table cells. Do not use
                   -webkit-line-clamp here: that engine paints the clamped
                   lines on top of each other, so a long address becomes
                   unreadable. A normal block with line-height clips cleanly. */
                .kx-label-100x150 .kx-label-from-addr,
                .kx-label-100x150 .kx-label-shipto-addr {
                    display: block;
                    overflow: hidden;
                    line-height: 1.35;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                }
                .kx-label-100x150 .kx-label-from-addr {
                    font-size: 9px;
                    max-height: 10mm;
                }
                .kx-label-100x150 .kx-label-shipto-addr {
                    font-size: 9px;
                    max-height: 14mm;
                }
                .kx-label-100x150 .kx-label-item-text {
                    display: -webkit-box;
                    -webkit-box-orient: vertical;
                    -webkit-line-clamp: 2;
                    overflow: hidden;
                    max-height: 5mm;
                    font-size: 7px;
                    line-height: 1.2;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                }
            </style>
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="keralariders_logistics.report_shipment_document_100x150_label"/>
            </t>
        </t>
    </template>

    <record id="action_report_shipment_100x150" model="ir.actions.report">
        <field name="name">AWB 100×150 mm landscape</field>
        <field name="model">logistics.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">keralariders_logistics.report_shipment_document_100x150</field>
        <field name="report_file">keralariders_logistics.report_shipment_document_100x150</field>
        <field name="print_report_name">'AWB 100x150 landscape - %s - %s' % (object.name, object.order_payment_type.upper())</field>
        <field name="paperformat_id" ref="paperformat_shipping_label_100x150"/>
    </record>

    <record id="paperformat_shipping_label_100x150_portrait" model="report.paperformat">
        <field name="name">KX Shipping Label 100×150 mm portrait</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">150</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="css_margins" eval="False"/>
    </record>

    <template id="report_shipment_document_100x150_portrait_label">
        <t t-set="seller_addr" t-value="o._awb_seller_address()"/>
        <t t-set="customer_phone" t-value="o._awb_customer_phone()"/>
        <t t-set="is_ip" t-value="o.fulfilment_method == 'indiapost'"/>
        <t t-set="arn" t-value="o.portal_indiapost_arn() or ''"/>
        <t t-set="item_desc" t-value="o._awb_label_item_description()"/>
        <div class="kx-label-100x150-portrait">
            <table class="kx-label-sheet">
                <tr>
                    <td class="kx-label-kx-logo" style="width: 50%; height: 14mm; border-bottom: 2px solid #000; padding: 1.2mm 2mm; vertical-align: middle;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="KeralaXpress"/>
                        <span t-else="" class="kx-label-kx-name">KERALAXPRESS</span>
                    </td>
                    <td class="kx-label-partner-logo" style="width: 50%; height: 14mm; border-bottom: 2px solid #000; padding: 1.2mm 2mm; text-align: right; vertical-align: middle;">
                        <img t-if="is_ip" t-att-src="o._awb_indiapost_logo_data_uri()"
                             class="awb-indiapost-logo"
                             alt="India Post"/>
                        <t t-elif="o.seller_id.image_1920">
                            <img t-att-src="image_data_uri(o.seller_id.image_1920)" alt="Seller"/>
                        </t>
                        <strong t-else="" t-field="o.shipping_from_name" class="kx-label-from-name"/>
                    </td>
                </tr>
                <tr>
                    <td class="kx-label-service" style="width: 34%; height: 30mm; border-top: 2px solid #000; border-bottom: 2px solid #000; padding: 1.2mm; text-align: center; vertical-align: middle;">
                        <div class="kx-label-service-mark">
                            <t t-esc="o._awb_label_service_code()"/>
                        </div>
                        <div class="kx-label-service-pin" t-field="o.shipping_to_zip"/>
                        <div class="kx-label-service-name">
                            <t t-esc="o._awb_label_service_name()"/>
                        </div>
                    </td>
                    <td class="kx-label-scan" style="width: 66%; height: 30mm; border-top: 2px solid #000; border-bottom: 2px solid #000; padding: 1.2mm 1.5mm; text-align: center; vertical-align: middle;">
                        <img t-if="not is_ip" t-att-src="o._awb_kx_barcode_img_src()"
                             class="kx-label-kx-barcode"
                             alt="AWB Barcode"/>
                        <img t-else="" t-att-src="o._awb_label_top_barcode_img_src()"
                             class="awb-indiapost-barcode"
                             alt="Shipping Barcode"/>
                        <div class="awb-indiapost-article">
                            <t t-if="arn"><span t-esc="arn"/></t>
                            <t t-else="">AWB <span t-field="o.name"/></t>
                        </div>
                        <div t-if="is_ip and o._awb_indiapost_customer_id()" class="awb-customer-id">
                            CUSTOMER ID: <t t-esc="o._awb_indiapost_customer_id()"/>
                        </div>
                        <img t-if="not is_ip" t-att-src="o._awb_kx_qr_img_src()"
                             class="kx-label-qr kx-label-kx-qr"
                             alt="Tracking QR"/>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="kx-label-shipto" style="height: 28mm; padding: 1.4mm 2mm; vertical-align: top; overflow: hidden;">
                        <div class="kx-label-kicker">SHIP TO</div>
                        <div class="kx-label-shipto-name text-uppercase"><span t-field="o.shipping_to_name"/></div>
                        <div class="kx-label-shipto-addr">
                            <span t-field="o.shipping_to_address"/>
                            <t t-if="o.shipping_to_district_id">, <span t-field="o.shipping_to_district_id"/></t>
                            <t t-if="o.shipping_to_state_id">, <span t-field="o.shipping_to_state_id"/></t>
                        </div>
                        <div class="kx-label-pin">PIN <span t-field="o.shipping_to_zip"/></div>
                        <div t-if="customer_phone" class="kx-label-mob">Mob: <t t-esc="customer_phone"/></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" class="kx-label-from" style="height: 22mm; border-top: 2px solid #000; padding: 1.4mm 2mm; vertical-align: top; overflow: hidden;">
                        <div class="kx-label-kicker">FROM</div>
                        <div class="kx-label-from-name text-uppercase"><t t-esc="seller_addr['name']"/></div>
                        <div class="kx-label-from-addr">
                            <t t-esc="seller_addr['street']"/>
                            <t t-if="seller_addr['district']">, <t t-esc="seller_addr['district']"/></t>
                            <t t-if="seller_addr['state']">, <t t-esc="seller_addr['state']"/></t>
                        </div>
                        <div class="kx-label-pin">
                            PIN <t t-esc="seller_addr['zip']"/>
                            <t t-if="seller_addr['phone']"> · Ph <t t-esc="seller_addr['phone']"/></t>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="kx-label-pay" style="width: 58%; height: 14mm; border-top: 2px solid #000; padding: 1.2mm 2mm; text-align: center; vertical-align: middle; border-right: 2px solid #000;">
                        <t t-if="o.order_payment_type == 'cod'">
                            <div class="kx-label-cod">COD</div>
                            <div class="kx-awb-money">
                                <t t-out="o._awb_format_money(o.cod_amount)"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="kx-label-prepaid">PREPAID</div>
                        </t>
                    </td>
                    <td class="kx-label-meta" style="width: 42%; height: 14mm; border-top: 2px solid #000; padding: 1.2mm 2mm; vertical-align: middle;">
                        <div><strong>Wt</strong> <span t-field="o.total_weight"/> kg</div>
                        <div><strong>Date</strong> <span t-field="o.order_date" t-options="{'widget': 'date'}"/></div>
                    </td>
                </tr>
                <tr t-if="item_desc">
                    <td colspan="2" class="kx-label-item" style="height: 8mm; border-top: 2px solid #000; padding: 1mm 2mm; vertical-align: middle; overflow: hidden;">
                        <div class="kx-label-item-text"><t t-esc="item_desc"/></div>
                    </td>
                </tr>
                <tr t-if="not is_ip">
                    <td colspan="2" class="kx-label-awb-barcode" style="height: 16mm; border-top: 2px solid #000; padding: 1mm 2mm; text-align: center; vertical-align: middle; overflow: hidden;">
                        <img t-att-src="o._awb_kx_barcode_img_src()"
                             class="kx-label-kx-barcode"
                             alt="AWB Barcode"/>
                        <div style="font-size: 9px; font-weight: 900; letter-spacing: 1px; margin-top: 0.3mm;">
                            AWB <span t-field="o.name"/>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="report_shipment_document_100x150_portrait">
        <t t-call="web.html_container">
            <meta charset="utf-8"/>
            <style type="text/css">
                <t t-out="docs._awb_money_font_css()"/>
                /* Portrait 100×150. Paperformat margins are 3 mm, so the
                   usable box is 94×144 mm. Stay shorter than that. */
                @page { size: 100mm 150mm; margin: 0; }
                html, body, body.o_body_pdf, body.o_body_html, #wrapwrap, main {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: auto !important;
                    max-width: none !important;
                    height: auto !important;
                    min-height: 0 !important;
                    overflow: visible !important;
                }
                .kx-label-100x150-portrait,
                .kx-label-100x150-portrait * {
                    box-sizing: border-box;
                }
                .kx-label-100x150-portrait {
                    color: #000;
                    background: #fff;
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 9px;
                    line-height: 1.15;
                    width: 94mm;
                    max-width: 100%;
                    height: 136mm;
                    max-height: 140mm;
                    overflow: hidden;
                    page-break-inside: avoid;
                    page-break-after: avoid;
                    page-break-before: auto;
                }
                .kx-label-100x150-portrait + .kx-label-100x150-portrait {
                    page-break-before: always;
                }
                .kx-label-100x150-portrait table {
                    width: 100%;
                    max-width: 100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                }
                .kx-label-100x150-portrait > table {
                    height: 136mm;
                    max-height: 136mm;
                    border: 2px solid #000;
                }
                .kx-label-100x150-portrait img {
                    max-width: 100% !important;
                    max-height: 12mm !important;
                }
                .kx-label-100x150-portrait .kx-label-kx-logo img,
                .kx-label-100x150-portrait .kx-label-partner-logo img {
                    max-height: 11mm !important;
                }
                .kx-label-100x150-portrait .kx-label-kx-name,
                .kx-label-100x150-portrait .kx-label-from-name,
                .kx-label-100x150-portrait .kx-label-shipto-name {
                    font-size: 13px;
                    font-weight: 900;
                    line-height: 1.2;
                }
                .kx-label-100x150-portrait .kx-label-kicker {
                    font-size: 8px;
                    font-weight: 700;
                    letter-spacing: 0.4px;
                    margin-bottom: 0.3mm;
                }
                .kx-label-100x150-portrait .kx-label-from,
                .kx-label-100x150-portrait .kx-label-shipto,
                .kx-label-100x150-portrait .kx-label-meta,
                .kx-label-100x150-portrait .kx-label-mob,
                .kx-label-100x150-portrait .awb-indiapost-article,
                .kx-label-100x150-portrait .awb-customer-id {
                    font-size: 10px;
                    font-weight: 700;
                    line-height: 1.25;
                }
                .kx-label-100x150-portrait .kx-label-pin,
                .kx-label-100x150-portrait .kx-label-service-pin {
                    font-size: 12px;
                    font-weight: 900;
                    margin-top: 0.6mm;
                }
                .kx-label-100x150-portrait .kx-label-service-mark {
                    border: 2px solid #000;
                    display: inline-block;
                    min-width: 12mm;
                    padding: 0.6mm 1.6mm;
                    font-size: 18px;
                    font-weight: 900;
                    line-height: 1;
                    letter-spacing: 1px;
                }
                .kx-label-100x150-portrait .kx-label-service-name,
                .kx-label-100x150-portrait .kx-label-prepaid,
                .kx-label-100x150-portrait .kx-label-cod {
                    font-size: 11px;
                    font-weight: 900;
                    letter-spacing: 0.4px;
                    text-transform: uppercase;
                }
                .kx-label-100x150-portrait .kx-label-cod {
                    border: 2px solid #000;
                    display: inline-block;
                    padding: 0.4mm 2mm;
                }
                .kx-label-100x150-portrait .kx-awb-money {
                    font-size: 11px;
                    font-weight: 700;
                    margin-top: 0.4mm;
                }
                .kx-label-100x150-portrait .kx-label-service-name {
                    margin-top: 0.8mm;
                }
                .kx-label-100x150-portrait .awb-indiapost-article,
                .kx-label-100x150-portrait .awb-customer-id {
                    margin-top: 0.4mm;
                }
                .kx-label-100x150-portrait .kx-label-qr {
                    display: block;
                    width: 14mm !important;
                    height: 14mm !important;
                    max-width: 14mm !important;
                    max-height: 14mm !important;
                    margin: 0.8mm auto 0 auto;
                }
                .kx-label-100x150-portrait img.kx-label-kx-qr {
                    width: 18mm !important;
                    height: 18mm !important;
                    max-width: 18mm !important;
                    max-height: 18mm !important;
                    image-rendering: -webkit-optimize-contrast;
                }
                .kx-label-100x150-portrait .awb-indiapost-barcode {
                    height: 12mm !important;
                    max-height: 12mm !important;
                }
                .kx-label-100x150-portrait img.kx-label-kx-barcode {
                    display: block;
                    width: 100%;
                    max-width: 100% !important;
                    height: auto !important;
                    max-height: 14mm !important;
                    margin: 0 auto;
                }
                .kx-label-100x150-portrait .kx-label-from-addr,
                .kx-label-100x150-portrait .kx-label-shipto-addr {
                    display: block;
                    overflow: hidden;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                }
                .kx-label-100x150-portrait .kx-label-from-addr {
                    font-size: 10px;
                    font-weight: 700;
                    max-height: 12mm;
                }
                .kx-label-100x150-portrait .kx-label-shipto-addr {
                    font-size: 10px;
                    font-weight: 700;
                    max-height: 12mm;
                }
                .kx-label-100x150-portrait .kx-label-item-text {
                    display: block;
                    overflow: hidden;
                    max-height: 6mm;
                    font-size: 10px;
                    font-weight: 700;
                    line-height: 1.25;
                    word-wrap: break-word;
                    overflow-wrap: break-word;
                }
            </style>
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="keralariders_logistics.report_shipment_document_100x150_portrait_label"/>
            </t>
        </t>
    </template>

    <record id="action_report_shipment_100x150_portrait" model="ir.actions.report">
        <field name="name">AWB 100×150 mm portrait</field>
        <field name="model">logistics.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">keralariders_logistics.report_shipment_document_100x150_portrait</field>
        <field name="report_file">keralariders_logistics.report_shipment_document_100x150_portrait</field>
        <field name="print_report_name">'AWB 100x150 portrait - %s - %s' % (object.name, object.order_payment_type.upper())</field>
        <field name="paperformat_id" ref="paperformat_shipping_label_100x150_portrait"/>
    </record>
</odoo>
