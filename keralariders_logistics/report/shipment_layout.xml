<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="paperformat_shipping_label" model="report.paperformat">
        <field name="name">Shipping Label Paperformat</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10.00</field>
        <field name="margin_left">4.0</field>
        <field name="margin_right">4.0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_shipment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id" />
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; color: black;">
                        
                        <table style="width: 100%; border-collapse: collapse; border: 2px solid black; border-bottom: 0px;">
                            <!-- HEADER -->
                            <tr>
                                <td class="text-center" colspan="1" style="border: 2px solid black; padding: 5px 10px; text-align: left; vertical-align: middle;" >
                                    <img t-if="o.seller_id.image_1920" t-att-src="image_data_uri(o.seller_id.image_1920)" style="max-width: 200px;" alt="Logo"/>
                                    <img t-else="" t-att-src="image_data_uri(company.logo)" style="max-width: 200px;" alt="Logo"/>
                                </td>
                                <td class="text-center" colspan="1" style="border: 2px solid black; padding: 5px 10px; text-align: left; vertical-align: middle;">
                                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-width: 200px;" alt="Logo" />
                                </td>
                            </tr>
                        </table>
                        <table style="width: 100%; border-collapse: collapse; border: 2px solid black;">

                            <!-- QR CODE AND AWB -->
                            <tr>
                                <td colspan="2" style="border: 2px solid black; padding: 12px; text-align: center;">
                                    <div style="margin: 0 auto; display: inline-block;">
                                        <img t-att-src="'https://api.qrserver.com/v1/create-qr-code/?size=150x150&amp;data=%s' % (o.name)" style="width: 150px; margin: 0 auto; display: block;" alt="QR Code"/>
                                    </div>
                                    <h6>
                                        <strong>AWB# <span t-field="o.name"/></strong>
                                    </h6>
                                </td>
                            </tr>
                            
                            <!-- SHIP TO & PAYMENT TYPE -->
                            <tr>
                                <td style="width: 70%; border: 2px solid black; padding: 10px 15px; vertical-align: middle; font-size: 15px;">
                                    <strong>Ship To: </strong><strong style="font-size: 17px;" t-field="o.shipping_to_name" class="text-uppercase"/>
                                    <br/>
                                    <strong>Address: </strong>
                                        <span t-field="o.shipping_to_address"/>, 
                                        <span t-field="o.shipping_to_district_id"/>, 
                                        <span t-field="o.shipping_to_state_id"/>
                                    <br/>
                                    <strong>PIN: </strong><strong t-field="o.shipping_to_zip"/>
                                </td>
                                <td style="width: 30%; border: 2px solid black; padding: 15px; text-align: center; vertical-align: middle;">
                                    <t t-if="o.order_payment_type == 'cod'">
                                        <div style="font-size: 32px; font-weight: 900; border: 4px solid black; padding: 10px; display: inline-block;">COD</div>
                                        <div style="font-size: 20px; font-weight: bold; margin-top: 15px;">
                                            <span t-field="o.cod_amount"/>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div style="font-size: 28px; font-weight: 900; letter-spacing: 1px;">PRE-PAID</div>
                                    </t>
                                </td>
                            </tr>
                            
                            <!-- SELLER AND DATE -->
                            <tr>
                                <td style="width: 70%; border: 2px solid black; padding: 10px 15px; vertical-align: middle; font-size: 15px;">
                                    <strong>Seller: </strong><span t-field="o.shipping_from_name" class="text-uppercase"/>
                                    <br/>
                                    <strong>Address: </strong>
                                        <span t-field="o.shipping_from_address"/>, 
                                        <span t-field="o.shipping_from_district_id"/>, 
                                        <span t-field="o.shipping_from_state_id"/>
                                    <br/>
                                    <strong>PIN: </strong><strong t-field="o.shipping_from_zip"/>
                                </td>
                                <td style="width: 30%; border: 2px solid black; padding: 10px 15px; vertical-align: middle; font-size: 15px;">
                                    <span><strong>Date: </strong><span t-field="o.order_date" t-options="{'widget': 'date'}"/></span>
                                    <br/>
                                    <span><strong>Weight: </strong><span t-field="o.total_weight"/> Kg</span>
                                </td>
                            </tr>
                            
                            <!-- PRODUCT DETAILS HEADER -->
                            <tr>
                                <td style="width: 70%; border: 2px solid black; border-bottom: 1px solid black; padding: 7px; font-weight: bold; font-size: 14px;">
                                    Item Description
                                </td>
                                <td style="width: 30%; border: 2px solid black; border-bottom: 1px solid black; padding: 7px; font-weight: bold; font-size: 14px; text-align: right;">
                                    Total Value
                                </td>
                            </tr>
                            
                            <!-- PRODUCT DETAILS -->
                            <tr>
                                <td style="width: 70%; border: 2px solid black; border-top: none; padding: 7px; vertical-align: middle; font-size: 14px;">
                                    <span t-field="o.item_description"/>
                                </td>
                                <td style="width: 30%; border: 2px solid black; border-top: none; text-align: right; padding: 7px; vertical-align: middle; font-size: 14px; font-weight: bold;">
                                    <span t-field="o.total_order_value"/>
                                </td>
                            </tr>

                            <!-- QR CODE OF ORDER -->
                            <tr>
                                <td colspan="2" style="border: 2px solid black; padding: 2px; text-align: center;">
                                    <div style="margin: 0 auto; display: inline-block;" class="mt-2">
                                        <img t-att-src="'https://bwipjs-api.metafloor.com/?bcid=code128&amp;text=%s&amp;scale=2' % o.order_id.name" style="width: 330px; height: 70px; margin: 0 auto; display: block;" alt="Order Barcode"/>
                                    </div>
                                    <h6>
                                        <strong>Order# <span t-field="o.order_id.name"/></strong>
                                    </h6>
                                </td>
                            </tr>
                            
                        </table>
                        
                        <t t-if="o.seller_notes">
                            <div style="border: 2px solid black; border-top: none; padding: 10px 15px; font-size: 12px;">
                                <b>Notes:</b> <span t-field="o.seller_notes"/>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_shipment" model="ir.actions.report">
        <field name="name">AWB / Shipping Label</field>
        <field name="model">logistics.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">keralariders_logistics.report_shipment_document</field>
        <field name="report_file">keralariders_logistics.report_shipment_document</field>
        <field name="print_report_name">'AWB - %s - %s' % (object.name, object.order_payment_type.upper())</field>
        <field name="binding_model_id" ref="model_logistics_shipment" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_shipping_label" />
    </record>
</odoo>