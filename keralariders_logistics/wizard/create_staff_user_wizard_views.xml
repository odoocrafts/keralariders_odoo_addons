<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_staff_user_wizard_form" model="ir.ui.view">
        <field name="name">logistics.create.staff.user.wizard.form</field>
        <field name="model">logistics.create.staff.user.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Staff User">
                <field name="user_id" invisible="1"/>
                <field name="is_edit" invisible="1"/>
                <group>
                    <group>
                        <field name="name" placeholder="e.g. Finance desk"/>
                        <field name="login" placeholder="staff@keralaxpress.com"/>
                        <field name="email" placeholder="staff@keralaxpress.com"/>
                    </group>
                    <group>
                        <field name="password" password="True"
                               placeholder="Leave empty to invite"/>
                        <field name="send_invite"
                               invisible="password"
                               readonly="password"/>
                    </group>
                </group>
                <group string="Access Areas">
                    <field name="pack_ids" widget="many2many_checkboxes" nolabel="1" colspan="2"/>
                </group>
                <div class="text-muted" colspan="2">
                    Internal User is always assigned. Seller / hub / DE portal
                    groups are not. Administration also grants Odoo Settings and Apps.
                </div>
                <footer>
                    <button string="Create Staff Login"
                            name="action_apply"
                            type="object"
                            class="btn-primary"
                            invisible="is_edit"/>
                    <button string="Save Access Areas"
                            name="action_apply"
                            type="object"
                            class="btn-primary"
                            invisible="not is_edit"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_staff_user_wizard" model="ir.actions.act_window">
        <field name="name">Create Staff User</field>
        <field name="res_model">logistics.create.staff.user.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_create_staff_user_wizard_form"/>
        <field name="context">{}</field>
    </record>
</odoo>
