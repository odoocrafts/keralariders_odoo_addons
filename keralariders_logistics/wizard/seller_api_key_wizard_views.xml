<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seller_api_key_wizard_form" model="ir.ui.view">
        <field name="name">logistics.seller.api.key.wizard.form</field>
        <field name="model">logistics.seller.api.key.wizard</field>
        <field name="arch" type="xml">
            <form string="API Key">
                <div class="alert alert-warning" role="alert"
                     invisible="not replaced_active_key">
                    The previous active key for this seller was revoked.
                    Integrations still using it will stop working.
                </div>
                <div class="alert alert-info" role="alert">
                    Copy the key and secret now. The secret is not stored
                    and this dialog will not show it again.
                </div>
                <group>
                    <field name="seller_id"/>
                    <field name="replaced_active_key" invisible="1"/>
                    <field name="credential_id" invisible="1"/>
                    <field name="api_key" widget="CopyClipboardChar"/>
                    <field name="api_secret" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
