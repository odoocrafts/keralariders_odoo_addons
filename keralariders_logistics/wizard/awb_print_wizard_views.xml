<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_awb_print_wizard_form" model="ir.ui.view">
        <field name="name">logistics.awb.print.wizard.form</field>
        <field name="model">logistics.awb.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print shipping labels">
                <group>
                    <field name="shipment_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                    <field name="paper_size" widget="radio" options="{'horizontal': true}"/>
                </group>
                <footer>
                    <button string="Print" name="action_print" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
