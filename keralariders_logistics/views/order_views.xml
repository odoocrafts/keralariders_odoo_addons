<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_order_tree" model="ir.ui.view">
        <field name="name">logistics.order.tree</field>
        <field name="model">logistics.order</field>
        <field name="arch" type="xml">
            <list string="Orders">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="order_date"/>
                <field name="pickup_date"/>
                <field name="shipment_count" string="Total Shipments"/>
                <field name="total_charges" sum="Total Charges"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pickup_requested'" decoration-primary="state == 'picked'" decoration-success="state == 'delivered'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_order_form" model="ir.ui.view">
        <field name="name">logistics.order.form</field>
        <field name="model">logistics.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <header>
                    <button name="action_print_awb_delivery_slips" class="oe_highlight" string="Print AWB/ Delivery Slips" type="object" icon="fa-print" invisible="state == 'cancelled'"/>
                    <button name="action_request_pickup" string="Request Pickup" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_picked_up" string="Mark as Picked" type="object" class="oe_highlight" invisible="state != 'pickup_requested'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state not in ('cancelled')"/>
                    <button name="action_cancel_order" string="Cancel" type="object" class="btn-secondary" invisible="state in ('cancelled', 'draft')" 
                        confirm="This will mark all Shipments under this order as cancelled. Are you sure you want to cancel this order?"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,pickup_requested,picked,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="seller_id" readonly="state != 'draft'"/>
                            <field name="order_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="pickup_date" readonly="state != 'draft'"/>
                            <field name="shipment_count"/>
                            <field name="total_charges"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shipments (AWBs)">
                            <field name="shipment_ids" readonly="state != 'draft'" context="{'default_seller_id': seller_id, 'default_order_date': order_date}">
                                <!-- <list>
                                    <field name="name"/>
                                    <field name="shipping_to_name"/>
                                    <field name="shipping_to_district_id"/>
                                    <field name="total_weight" force_save="1"/>
                                    <field name="order_payment_type"/>
                                    <field name="total_order_value"/>
                                    <field name="delivery_charges_total" force_save="1"/>
                                    <field name="state" widget="badge" decoration-info="state == 'order_added'" decoration-success="state == 'delivered'"/>
                                </list> -->
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_logistics_order_kanban" model="ir.ui.view">
        <field name="name">logistics.order.kanban</field>
        <field name="model">logistics.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="state"
                    records_draggable="0"
                    quick_create="0">

                <field name="name"/>
                <field name="seller_id"/>
                <field name="order_date"/>
                <field name="pickup_date"/>
                <field name="shipment_count"/>
                <field name="total_charges"/>
                <field name="currency_id"/>
                <field name="state"/>

                <templates>
                    <t t-name="card" class="mt-1">
                        <div class="oe_kanban_global_click">

                            <div class="d-flex justify-content-between align-items-center">
                                <strong>
                                    <field name="name"/>
                                </strong>

                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pickup_requested'" decoration-primary="state == 'picked'" decoration-success="state == 'delivered'" decoration-danger="state == 'cancelled'"/>
                            </div>

                            <div class="text-muted mt-1">
                                <i class="fa fa-user me-1"/>
                                <field name="seller_id"/>
                            </div>

                            <hr class="my-2"/>

                            <div class="d-flex justify-content-between">
                                <span>
                                    <i class="fa fa-calendar me-1"/>
                                    Order
                                </span>
                                <strong>
                                    <field name="order_date"/>
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between mt-1"
                                invisible="not pickup_date">
                                <span>
                                    <i class="fa fa-truck me-1"/>
                                    Pickup
                                </span>
                                <strong>
                                    <field name="pickup_date"/>
                                </strong>
                            </div>
                            <div class="d-flex justify-content-between mt-2">
                                <span>
                                    <i class="fa fa-cubes me-1"/>
                                    Delivered Shipments
                                </span>
                                <strong>
                                    <field name="delivered_shipment_count" class="text-success"/> / <field name="shipment_count" class="text-info"/>
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between mt-1">
                                <span>
                                    <i class="fa fa-money me-1"/>
                                    Total Delivery Charges
                                </span>

                                <strong>
                                    <field name="total_charges"
                                        widget="monetary"
                                        options="{'currency_field':'currency_id'}"/>
                                </strong>
                            </div>

                            <div class="d-grid gap-1 mt-3">

                                <button name="action_print_awb_delivery_slips"
                                        type="object"
                                        class="btn btn-outline-primary btn-sm"
                                        invisible="state == 'cancelled'">
                                    <i class="fa fa-print me-1"/>
                                    Print AWB / Delivery Slips
                                </button>

                                <!-- <button name="action_request_pickup"
                                        type="object"
                                        class="btn btn-primary btn-sm"
                                        invisible="state != 'draft'">
                                    Request Pickup
                                </button> -->

                                <button name="action_mark_picked_up"
                                        type="object"
                                        class="btn btn-success btn-sm"
                                        invisible="state != 'pickup_requested'">
                                    Mark as Picked
                                </button>

                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <record id="view_logistics_order_search" model="ir.ui.view">
        <field name="name">logistics.order.search</field>
        <field name="model">logistics.order</field>
        <field name="arch" type="xml">
            <search string="Search Orders">

                <!-- Global Search -->
                <field name="name"
                    string="Order"
                    filter_domain="[
                        '|','|',
                        ('name','ilike',self),
                        ('seller_id.name','ilike',self),
                        ('shipment_ids.name','ilike',self)
                    ]"/>

                <field name="seller_id"/>
                <field name="order_date"/>
                <field name="pickup_date"/>

                <separator/>

                <!-- Status -->

                <filter name="draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>

                <filter name="pickup_requested"
                        string="Pickup Requested"
                        domain="[('state','=','pickup_requested')]"/>

                <filter name="picked"
                        string="Picked"
                        domain="[('state','=','picked')]"/>

                <filter name="partial"
                        string="Partial Delivery"
                        domain="[('state','=','partial')]"/>

                <filter name="delivered"
                        string="Delivered"
                        domain="[('state','=','delivered')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state','=','cancelled')]"/>

                <separator/>

                <!-- Date -->

                <filter name="today"
                        string="Today"
                        domain="[('order_date','=',context_today())]"/>

                <filter name="month"
                        string="Month"
                        date="order_date"/>

                <separator/>

                <!-- Other Filters -->

                <filter name="has_pickup_date"
                        string="Pickup Scheduled"
                        domain="[('pickup_date','!=',False)]"/>

                <separator/>

                <!-- Group By -->

                <group>

                    <filter string="Status"
                            name="group_state"
                            context="{'group_by':'state'}"/>

                    <filter string="Seller"
                            name="group_seller"
                            context="{'group_by':'seller_id'}"/>

                    <filter string="Order Date"
                            name="group_order_date"
                            context="{'group_by':'order_date'}"/>

                    <filter string="Pickup Date"
                            name="group_pickup_date"
                            context="{'group_by':'pickup_date'}"/>

                </group>

            </search>
        </field>
    </record>

    <record id="action_logistics_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">logistics.order</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_logistics_order" name="Orders" parent="menu_logistics_operations" action="action_logistics_order" sequence="1"/>
</odoo>
