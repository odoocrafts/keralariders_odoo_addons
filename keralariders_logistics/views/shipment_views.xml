<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Shipment Search View -->
    <record id="view_logistics_shipment_search" model="ir.ui.view">
        <field name="name">logistics.shipment.search</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <search string="Search Shipments">

                <!-- Search -->
                <field name="name"/>
                <field name="order_id"/>
                <field name="seller_id"/>
                <field name="shipping_to_name"/>
                <field name="shipping_to_mobile"/>
                <field name="shipping_to_email"/>
                <field name="delivery_executive_id"/>
                <field name="pickup_executive_id"/>
                <field name="indiapost_article_number" string="India Post Article No."/>

                <separator/>

                <!-- India Post -->
                <filter name="indiapost"
                        string="India Post"
                        domain="[('fulfilment_method', '=', 'indiapost')]"/>

                <filter name="own_network"
                        string="Hub Network"
                        domain="[('fulfilment_method', '=', 'own_network')]"/>

                <filter name="indiapost_awaiting_booking"
                        string="Awaiting India Post Booking"
                        domain="[('fulfilment_method', '=', 'indiapost'), ('indiapost_article_number', '=', False), ('state', 'not in', ['cancelled', 'delivered', 'returned'])]"/>

                <filter name="indiapost_booking_error"
                        string="India Post Booking Rejected"
                        domain="[('indiapost_booking_state', '=', 'error')]"/>

                <filter name="indiapost_no_label"
                        string="India Post Label Missing"
                        domain="[('indiapost_article_number', '!=', False), ('indiapost_label_pdf', '=', False)]"/>

                <separator/>

                <!-- Quick Filters -->
                <filter name="my_shipments"
                        string="My Shipments"
                        domain="[('create_uid', '=', uid)]"/>

                <filter name="wallet_added"
                        string="Wallet Deducted"
                        domain="[('wallet_transaction_id', '!=', False)]"/>

                <filter name="cod_orders"
                        string="COD Orders"
                        domain="[('order_payment_type', '=', 'cod')]"/>

                <filter name="prepaid_orders"
                        string="Prepaid Orders"
                        domain="[('order_payment_type', '=', 'prepaid')]"/>

                <filter name="cod_orders_paid"
                        string="COD Fully Paid"
                        domain="[('cod_balance_amount', '&lt;=', 0)]"/>


                <separator/>

                <!-- Delivery Status -->
                <filter name="order_added"
                        string="Order Added"
                        domain="[('state', '=', 'order_added')]"/>

                <filter name="pickup_requested"
                        string="Pickup Requested"
                        domain="[('state', '=', 'pickup_requested')]"/>

                <filter name="picked"
                        string="Picked"
                        domain="[('state', '=', 'picked')]"/>

                <filter name="in_transit"
                        string="In Transit"
                        domain="[('state', '=', 'in_transit')]"/>

                <filter name="at_source_hub"
                        string="At Source Hub"
                        domain="[('state', '=', 'at_source_hub')]"/>
                <filter name="at_central_hub"
                        string="At Central Hub"
                        domain="[('state', '=', 'at_central_hub')]"/>
                <filter name="at_destination_hub"
                        string="At Destination Hub"
                        domain="[('state', '=', 'at_destination_hub')]"/>

                <filter name="out_for_delivery"
                        string="Out for Delivery"
                        domain="[('state', '=', 'out_for_delivery')]"/>

                <filter name="delivery_failed"
                        string="Delivery Failed"
                        domain="[('state', '=', 'delivery_failed')]"/>

                <filter name="at_hub"
                        string="In Hub Custody"
                        domain="[('custodian_type', '=', 'hub')]"/>

                <filter name="unassigned_active_leg"
                        string="Active Leg Unassigned"
                        domain="[('active_leg_id.assigned_de_id', '=', False), ('active_leg_id.state', 'in', ['planned', 'assigned'])]"/>

                <filter name="delivered"
                        string="Delivered"
                        domain="[('state', '=', 'delivered')]"/>

                <filter name="return_requested"
                        string="Return Requested"
                        domain="[('state', '=', 'return_requested')]"/>

                <filter name="return_picked"
                        string="Return Picked"
                        domain="[('state', '=', 'return_picked')]"/>

                <filter name="returned"
                        string="Returned"
                        domain="[('state', '=', 'returned')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <!-- Date Filters -->
                <filter name="today"
                        string="Today"
                        domain="[('order_date', '=', context_today())]"/>

                <filter string="This Week" name="this_week"

                domain="[('order_date', '&lt;=', ((context_today()+relativedelta(weeks=0, weekday=-1)).strftime('%Y-%m-%d'))), 

                ('order_date', '&gt;=', ((context_today()-relativedelta(weeks=1, weekday=0)).strftime('%Y-%m-%d')))]"/>
                <filter name="month"
                        string="Month"
                        date="order_date"/>

                <separator/>

                <!-- Group By -->
                <group>

                    <filter string="Seller"
                            name="group_seller"
                            context="{'group_by':'seller_id'}"/>

                    <filter string="Delivery Executive"
                            name="group_delivery_executive"
                            context="{'group_by':'delivery_executive_id'}"/>

                    <filter string="Status"
                            name="group_state"
                            context="{'group_by':'state'}"/>

                    <filter string="Payment Type"
                            name="group_payment"
                            context="{'group_by':'order_payment_type'}"/>

                    <filter string="Order Date"
                            name="group_order_date"
                            context="{'group_by':'order_date'}"/>

                    <filter string="From District"
                            name="group_from_district"
                            context="{'group_by':'shipping_from_district_id'}"/>

                    <filter string="Current Hub"
                            name="group_current_hub"
                            context="{'group_by':'current_hub_id'}"/>

                    <filter string="Custodian"
                            name="group_custodian"
                            context="{'group_by':'custodian_type'}"/>

                    <filter string="To District"
                            name="group_to_district"
                            context="{'group_by':'shipping_to_district_id'}"/>

                    <filter string="Fulfilment Method"
                            name="group_fulfilment_method"
                            context="{'group_by':'fulfilment_method'}"/>

                </group>

            </search>
        </field>
    </record>

    <!-- Shipment List View -->
    <record id="view_shipment_list" model="ir.ui.view">
        <field name="name">Shipment List</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments">
                <field name="name" string="Reference No." width="100"/>
                <field name="order_id" width="100"/>
                <field name="seller_id" width="100"/>
                <field name="shipping_to_name" width="100" string="Shipping To"/>
                <field name="delivery_executive_id" string="Delivery Exec." width="100"/>
                <field name="pickup_executive_id" string="Pickup Exec." width="100" optional="show"/>
                <field name="custodian_display" string="Custodian" width="120"/>
                <field name="order_date" width="100"/>
                <field name="shipping_from_district_id" string="Shipping From" width="100"/>
                <field name="shipping_to_district_id" string="Shipping To" width="100"/>
                <field name="order_payment_type" string="Payment Type" width="100"/>
                <field name="fulfilment_method" string="Fulfilment" width="100" optional="show"/>
                <field name="indiapost_article_number" string="India Post AWB" width="130" optional="show"/>
                <field name="indiapost_booking_state" string="IP Booking" width="100" optional="hide"
                       widget="badge"
                       decoration-success="indiapost_booking_state == 'booked'"
                       decoration-danger="indiapost_booking_state == 'error'"
                       decoration-warning="indiapost_booking_state == 'submitted'"/>
                <field name="state" widget="badge"
                    decoration-info="state in ('order_added', 'return_picked')"
                    decoration-warning="state in ('pickup_requested','return_requested','out_for_delivery')"
                    decoration-primary="state == 'picked'"
                    decoration-muted="state == 'in_transit'"
                    decoration-success="state in ('delivered', 'returned')"
                    decoration-danger="state in ('cancelled', 'delivery_failed')"
                    width="100"
                />                
                <field name="cod_amount" string="COD Amount" width="100" sum="COD Amount" invisible="order_payment_type != 'cod'" options="{'fg_color': 'brown: cod_balance_amount > 0; green: cod_balance_amount &lt;=0 ;'}"/>
                <field name="cod_balance_amount" string="COD Balance Amount" optional="hide" width="100" sum="COD Amount" invisible="order_payment_type != 'cod'"/>
                <field name="estimated_delivery_date" string="Est. Del Date" width="100"/>
                <field name="delivery_duration_display" string="Time to Deliver" width="100" optional="show"/>
                <field name="delivery_charges_total" force_save="1" string="Delivery Charge" width="100" sum="Delivery Charges" options="{'fg_color': 'brown: not wallet_transaction_id; green: wallet_transaction_id;'}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="wallet_transaction_id" column_invisible="1"/>
                <button name="%(keralariders_logistics.action_report_shipment)d" class="oe_highlight" string="Print AWB" type="action" icon="fa-print" width="100"/>
            </list>
        </field>
    </record>

    <!-- Shipment Form View -->
    <record id="view_shipment_form" model="ir.ui.view">
        <field name="name">Shipment Form</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="%(keralariders_logistics.action_report_shipment)d" string="Print AWB" type="action" class="btn-primary"/>
                    <!-- India Post actions. All idempotent: booking skips
                         anything that already has an article number. -->
                    <button name="action_indiapost_book" type="object"
                            string="Book with India Post" class="btn-primary"
                            invisible="not is_indiapost or indiapost_article_number or state == 'cancelled'"
                            groups="keralariders_logistics.group_logistics_admin"/>
                    <button name="action_indiapost_quote" type="object"
                            string="Refresh India Post Rate" class="btn-secondary"
                            invisible="not is_indiapost or indiapost_article_number"
                            groups="keralariders_logistics.group_logistics_admin"/>
                    <button name="action_indiapost_fetch_label" type="object"
                            string="Fetch India Post Label" class="btn-secondary"
                            invisible="not indiapost_article_number or indiapost_label_pdf"
                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_hub_manager"/>
                    <button name="action_indiapost_open_label" type="object"
                            string="Print India Post Label" class="btn-primary"
                            invisible="not indiapost_label_pdf"/>
                    <button name="action_indiapost_sync_tracking" type="object"
                            string="Sync India Post Tracking" class="btn-secondary"
                            invisible="not indiapost_article_number"
                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_hub_manager"/>
                    <button name="action_indiapost_switch_to_own_network" type="object"
                            string="Divert to Hub Network" class="btn-warning"
                            invisible="not is_indiapost or indiapost_article_number or state == 'cancelled'"
                            groups="keralariders_logistics.group_logistics_admin"
                            confirm="Deliver this shipment through the KeralaXpress hub network instead of India Post? The reserved barcode will be voided and charges revert to the weight slab table."/>
                    <button name="action_request_return" type="object" string="Request Return (Free)"
                            invisible="state != 'delivered' and not (state == 'delivery_failed' and custodian_type == 'hub' and delivery_fail_count &gt;= 1)"
                            groups="keralariders_logistics.group_logistics_admin"
                            class="btn-warning"
                            confirm="Start free return: pickup from customer → hubs → seller? (From Delivery Failed at hub, customer pickup is skipped.) No wallet deduction."/>
                    <button name="action_hub_return_to_previous_hub" type="object" string="Return to Previous Hub"
                            invisible="state != 'delivery_failed' or custodian_type != 'hub' or delivery_fail_count &lt; 1 or is_return_journey"
                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_hub_manager"
                            class="btn-secondary"
                            confirm="Open reverse hub transfer back to the source hub?"/>
                    <button name="action_hub_return_to_seller" type="object" string="Return to Seller (Failed)"
                            invisible="state != 'delivery_failed' or custodian_type != 'hub' or delivery_fail_count &lt; 1 or is_return_journey"
                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_hub_manager"
                            class="btn-warning"
                            confirm="Start free return to seller? Customer pickup will be skipped."/>
                    <button name="action_mark_picked" type="object" string="Mark Picked"
                            invisible="state not in ('pickup_requested', 'order_added', 'return_requested')"
                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_executive"
                            class="btn-secondary"/>
                    <button name="action_hub_receive" type="object" string="Hub Receive"
                            invisible="custodian_type == 'hub' or state in ('delivered', 'cancelled', 'returned')"
                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_hub_manager"
                            class="btn-secondary"/>
                    <button name="action_central_pass_through" type="object" string="Record Thrissur Pass-Through"
                            invisible="state in ('delivered', 'cancelled', 'returned')"
                            groups="keralariders_logistics.group_logistics_admin"
                            class="btn-secondary"
                            confirm="Record optional physical pass-through at Thrissur Main Hub? Package stays In Transit."/>
                    <button name="action_skip_hub_local_delivery" type="object" string="Deliver Locally (Skip Hub)"
                            invisible="state not in ('picked', 'return_picked') or custodian_type != 'de'"
                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_executive"
                            class="btn-secondary"
                            confirm="Same-district local delivery — skip hub inventory and go Out for Delivery?"/>
                    <button name="action_cancel_shipment" type="object" string="Cancel Shipment"
                            invisible="state in ('delivered', 'cancelled', 'returned')"
                            groups="keralariders_logistics.group_logistics_admin"
                            class="btn-secondary"
                            confirm="Cancel this shipment?"/>
                    <field name="state" widget="statusbar" options="{'clickable': 0}"
                           statusbar_visible="order_added,pickup_requested,picked,in_transit,at_source_hub,at_destination_hub,out_for_delivery,delivery_failed,delivered,return_requested,return_picked,returned"/>
                </header>
                <sheet>
                    <div class="oe_title" >
                        <h1 class="text-info">
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Order Info">
                            <field name="seller_id" required="1"/>
                            <field name="order_id"/>
                            <field name="order_date"/>
                            <field name="order_payment_type"/>
                            <field name="is_return_journey" readonly="1"
                                      invisible="not is_return_journey"/>
                            <!-- <field name="cod_amount" invisible="order_payment_type != 'cod'"/> -->
                            <label for="cod_amount" invisible="order_payment_type != 'cod'"/>
                            <div class="d-flex align-items-center" invisible="order_payment_type != 'cod'">
                                <field name="cod_amount"
                                    class="oe_inline me-2"
                                    force_save="1"/>

                                <i class="fa fa-check-circle text-success me-2"
                                invisible="cod_balance_amount > 0"/>

                                <button name="action_add_cod_payment_transfer"
                                        type="object"
                                        class="btn btn-info btn-sm me-1"
                                        icon="fa-credit-card"
                                        string="Add Payment"
                                        invisible="cod_balance_amount &lt;= 0"/>
                                <button name="action_view_cod_payment_transfers"
                                        type="object"
                                        class="btn btn-primary btn-sm"
                                        icon="fa-eye"
                                        string="View Transfers"
                                        invisible="not cod_payment_transfer_ids"/>
                            </div>
                            <field name="cod_paid_amount" invisible="order_payment_type != 'cod'" readonly="1" force_save="1"/>
                            <field name="cod_balance_amount" invisible="order_payment_type != 'cod'" readonly="1" force_save="1"/>
                            <field name="cod_payment_transfer_ids" widget="many2many_tags" invisible="1"/>
                            <field name="tracking_url" widget="url"/>

                        </group>
                        <group string="Delivery Charges">
                            <field name="currency_id" invisible="1"/>
                            <field name="is_indiapost" invisible="1"/>
                            <field name="total_weight"/>
                            <label for="length_cm" string="Dimensions (cm)"/>
                            <div class="o_row">
                                <field name="length_cm" class="oe_inline"
                                       required="is_indiapost"/>
                                <span class="mx-1">x</span>
                                <field name="breadth_cm" class="oe_inline"
                                       required="is_indiapost"/>
                                <span class="mx-1">x</span>
                                <field name="height_cm" class="oe_inline"
                                       required="is_indiapost"/>
                            </div>
                            <field name="is_cylindrical"/>
                            <field name="volumetric_weight_g" invisible="not is_indiapost"/>
                            <field name="chargeable_weight_g" invisible="not is_indiapost"/>
                            <div class="alert alert-danger mb-1" colspan="2" role="alert"
                                 invisible="not indiapost_package_error">
                                <field name="indiapost_package_error" nolabel="1" readonly="1"/>
                            </div>
                            <div class="alert alert-warning mb-1" colspan="2" role="alert"
                                 invisible="indiapost_package_error or not indiapost_package_warning">
                                <field name="indiapost_package_warning" nolabel="1" readonly="1"/>
                            </div>
                            <field name="delivery_charges_subtotal" force_save="1"/>
                            <field name="tax_percentage" widget="percentage" string="Tax (GST) %" invisible="1"/>
                            
                            <!-- <label for="delivery_charges_total"/> -->
                            <label for="delivery_charges_total"/>
                            <div class="d-flex align-items-center">
                                <field name="delivery_charges_total"
                                    class="oe_inline me-2"
                                    force_save="1"/>

                                <i class="fa fa-check-circle text-success me-2"
                                invisible="not wallet_transaction_id"/>

                                <button name="action_add_wallet_transaction"
                                        type="object"
                                        class="btn btn-warning btn-sm me-1"
                                        icon="fa-credit-card"
                                        string="Deduct from Wallet"
                                        invisible="wallet_transaction_id"/>

                                <button name="action_view_wallet_transaction"
                                        type="object"
                                        class="btn btn-primary btn-sm"
                                        icon="fa-eye"
                                        string="View Transaction"
                                        invisible="not wallet_transaction_id"/>

                                <button name="delete_wallet_transaction"
                                        type="object"
                                        string="Remove Transaction"
                                        class="btn btn-danger btn-sm"
                                        icon="fa-trash"
                                        confirm="This will delete the wallet transaction and restore the wallet balance. Continue?"
                                        invisible="not wallet_transaction_id"/>
                            </div>
                            <!-- Stamped when someone prices a shipment by hand.
                                 The wallet is debited at this amount instead of
                                 the rate card, but only while the inputs it was
                                 set against are unchanged. -->
                            <field name="delivery_charge_override_signature" invisible="1"/>
                            <field name="delivery_charge_override_amount"
                                   invisible="not delivery_charge_override_signature"/>
                            <field name="delivery_charge_override_uid"
                                   invisible="not delivery_charge_override_signature"/>
                            <field name="delivery_charge_override_on"
                                   invisible="not delivery_charge_override_signature"/>
                        </group>
                    </group>
                    <group>
                        <group string="Products &amp; Item Details">
                            <field name="item_description"/>
                            <field name="total_order_value"/>
                            <field name="seller_notes"/>
                        </group>
                        <group string="Delivery">
                            <field name="pickup_executive_id"/>
                            <field name="delivery_executive_id"/>
                            <field name="estimated_delivery_date"/>
                            <field name="actual_delivery_date"/>
                            <field name="delivery_duration_display" string="Time to Deliver" readonly="1"
                                      invisible="not delivery_duration_display"/>
                            <field name="delivery_remarks"/>
                            <field name="delivery_fail_count" readonly="1"/>
                            <field name="source_hub_id" string="Source Hub" readonly="1" force_save="1"/>
                            <field name="destination_hub_id" string="Destination Hub" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <group string="Custody">
                        <group>
                            <field name="custodian_type"/>
                            <field name="custodian_de_id"/>
                            <field name="current_hub_id"/>
                            <field name="active_leg_id"/>
                        </group>
                        <group>
                            <field name="route_locked"/>
                            <field name="event_count"/>
                            <field name="picked_on" readonly="1"/>
                            <field name="delivered_on" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Shipping From (Seller)">
                            <field name="shipping_from_name" string="Name"/>
                            <field name="shipping_from_address" string="Address"/>
                            <field name="shipping_from_zip" string="Pincode" force_save="1"/>
                            <field name="shipping_from_district_id" string="District"/>
                            <field name="shipping_from_state_id" string="State"/>
                            <field name="shipping_from_country_id" string="Country"/>
                        </group>
                        <group string="Shipping To (Customer)">
                            <field name="shipping_to_name" string="Name"/>
                            <field name="shipping_to_address" string="Address" required="1"/>
                            <field name="shipping_to_zip" string="Pincode" force_save="1" required="1"/>
                            <field name="shipping_to_district_id" string="District"/>
                            <field name="shipping_to_state_id" string="State"/>
                            <field name="shipping_to_country_id" string="Country"/>
                            <field name="shipping_to_mobile" string="Mobile" required="1"/>
                            <field name="shipping_to_email" string="Email"/>
                        </group>
                    </group>
                    <group string="Billing Address" invisible="1">
                        <group>
                            <field name="billing_name" string="Name"/>
                            <field name="billing_address" string="Address"/>
                            <field name="billing_zip" string="Pincode"/>
                            <field name="billing_district_id" string="District"/>
                            <field name="billing_state_id" string="State"/>
                            <field name="billing_country_id" string="Country"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="India Post" name="indiapost"
                              invisible="not is_indiapost and not indiapost_article_number">
                            <group>
                                <group string="Booking">
                                    <field name="fulfilment_method" readonly="1"/>
                                    <field name="indiapost_booking_state"/>
                                    <field name="indiapost_article_number"/>
                                    <field name="indiapost_product_code"/>
                                    <field name="indiapost_shape"/>
                                    <field name="indiapost_barcode_id"/>
                                    <field name="indiapost_booked_on"/>
                                    <field name="indiapost_batch_id"/>
                                    <field name="indiapost_correlation_id"/>
                                    <field name="indiapost_mail_booking_dom_id" optional="hide"/>
                                    <field name="indiapost_offset_number"/>
                                    <field name="indiapost_block_number"/>
                                </group>
                                <group string="Pickup">
                                    <field name="indiapost_pickup_slot"/>
                                    <field name="indiapost_pickup_date"/>
                                    <field name="indiapost_pickup_office_id"/>
                                    <field name="indiapost_pickup_office_name"/>
                                    <field name="indiapost_dest_office_id"/>
                                    <field name="indiapost_dest_office_name"/>
                                </group>
                            </group>
                            <div class="alert alert-danger" role="alert"
                                 invisible="not indiapost_booking_error">
                                <strong>Last booking rejection</strong>
                                <field name="indiapost_booking_error" nolabel="1" readonly="1"/>
                            </div>
                            <group>
                                <group string="Rate Quoted by India Post">
                                    <field name="indiapost_base_tariff"/>
                                    <field name="indiapost_vas_charges"/>
                                    <field name="indiapost_tax_amount"/>
                                    <field name="indiapost_total_tariff"/>
                                    <field name="indiapost_calculated_tariff"
                                           help="Amount India Post returned at booking. A mismatch with the quoted total means the rate moved between quote and booking."/>
                                    <field name="indiapost_quoted_weight_g"/>
                                    <field name="indiapost_quoted_chargeable_g"/>
                                    <field name="indiapost_distance_display"/>
                                    <field name="indiapost_tariff_quoted_on"/>
                                    <field name="indiapost_quote_signature"
                                           groups="keralariders_logistics.group_logistics_admin"
                                           help="The package as India Post priced it. Compared with the shipment as it stands now to decide whether the rate above still applies."/>
                                    <field name="indiapost_needs_quote" invisible="1"/>
                                    <div class="text-warning" colspan="2"
                                         invisible="not indiapost_needs_quote or not indiapost_tariff_quoted_on">
                                        The package has changed since this rate
                                        was quoted, so it no longer applies. It
                                        will be re-fetched before the wallet is
                                        debited.
                                    </div>
                                </group>
                                <group string="Value Added Services">
                                    <field name="indiapost_vas_pod"/>
                                    <field name="indiapost_vas_reg"/>
                                    <field name="indiapost_vas_ack"/>
                                    <field name="indiapost_vas_otp"/>
                                    <field name="indiapost_insurance_value"/>
                                    <div class="text-muted" colspan="2"
                                         invisible="not indiapost_insurance_value">
                                        India Post insurance is steeply
                                        non-linear: roughly 6% of declared
                                        value, so it can exceed the postage
                                        several times over.
                                    </div>
                                </group>
                            </group>
                            <group>
                                <group string="Label">
                                    <field name="indiapost_label_size"/>
                                    <field name="indiapost_label_filename" invisible="1"/>
                                    <field name="indiapost_label_pdf"
                                           filename="indiapost_label_filename"/>
                                    <field name="indiapost_label_fetched_on"/>
                                </group>
                                <group string="Tracking">
                                    <field name="indiapost_del_status"/>
                                    <field name="indiapost_last_tracking_sync"/>
                                    <field name="indiapost_tracking_ref" optional="hide"/>
                                </group>
                            </group>
                        </page>
                        <page string="Estimated Route">
                            <button name="action_recompute_estimated_route"
                                    type="object"
                                    class="btn btn-primary btn-sm mb-2"
                                    icon="fa-refresh"
                                    string="Recompute Estimated Route"
                                    groups="keralariders_logistics.group_logistics_admin"/>
                            <field name="estimated_route_html"/>
                        </page>
                        <page string="Route Legs">
                            <field name="estimated_route_ids">
                                <list>
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="operation_type"/>
                                    <field name="state"/>
                                    <field name="assigned_de_id"/>
                                    <field name="from_hub_id"/>
                                    <field name="to_hub_id"/>
                                    <field name="executive1_id" string="Suggested DE" optional="show"/>
                                    <field name="executive2_id" string="Suggested DE 2" optional="hide"/>
                                    <field name="started_at" optional="show"/>
                                    <field name="completed_at" optional="show"/>
                                    <button name="action_clear_assignee" type="object" string="Clear Assignee"
                                            icon="fa-user-times"
                                            invisible="not assigned_de_id or state in ('done', 'skipped', 'in_progress')"
                                            groups="keralariders_logistics.group_logistics_admin,keralariders_logistics.group_logistics_hub_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Custody Events">
                            <field name="event_ids">
                                <list create="0" edit="0" delete="0">
                                    <field name="event_time"/>
                                    <field name="event_type"/>
                                    <field name="hub_id"/>
                                    <field name="actor_de_id"/>
                                    <field name="from_custodian_type"/>
                                    <field name="to_custodian_type"/>
                                    <field name="scanned_code" optional="hide"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Shipment Window Action -->
    <record id="action_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">logistics.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_shipment_search"/>
        <field name="context">{'search_default_this_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new shipment
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_shipment" name="Shipments" action="action_shipment" parent="menu_logistics_operations" sequence="2"/>

</odoo>