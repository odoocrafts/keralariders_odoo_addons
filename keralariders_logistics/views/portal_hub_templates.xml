<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_hub_manager" name="Show Hub Manager Portal Entries" customize_show="True" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="is_hub_manager">
                <t t-call="keralariders_logistics.logistics_portal_card">
                    <t t-set="title">My Hub</t>
                    <t t-set="url" t-value="'/my/hub'"/>
                    <t t-set="count_text" t-value="hub_inventory_count if hub_inventory_count else '0'"/>
                    <t t-set="icon" t-value="'/keralariders_logistics/static/src/img/shipment.svg'"/>
                    <t t-set="text">Hub inventory, receive, dispatch &amp; assign pickup</t>
                </t>
                <t t-call="keralariders_logistics.logistics_portal_card">
                    <t t-set="title">Hub COD Banking</t>
                    <t t-set="url" t-value="'/my/hub/cod'"/>
                    <t t-set="count_text" t-value="hub_cod_unbanked_count if hub_cod_unbanked_count else '0'"/>
                    <t t-set="icon" t-value="'/keralariders_logistics/static/src/img/shipment.svg'"/>
                    <t t-set="text">Confirm deposits &amp; bank to company</t>
                </t>
            </t>
        </xpath>
    </template>

    <template id="portal_my_hub_home" name="Hub Manager Home">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <t t-if="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>
                <t t-if="success">
                    <div class="alert alert-success"><t t-esc="success"/></div>
                </t>
                <h3 class="mb-3">Hub Operations</h3>
                <p class="text-muted">Managed hubs:
                    <t t-foreach="hubs" t-as="hub">
                        <span class="badge text-bg-secondary me-1"><t t-esc="hub.name"/></span>
                    </t>
                </p>
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">Pending pickups</h5>
                                <p class="display-6 mb-0"><t t-esc="pending_pickups"/></p>
                                <p class="small text-muted mb-2">
                                    <t t-esc="unassigned_pickups"/> unassigned
                                </p>
                                <a href="/my/hub/pickups" class="btn btn-primary btn-sm">Assign pickup</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">Inventory</h5>
                                <p class="display-6"><t t-esc="inventory_count"/></p>
                                <a href="/my/hub/inventory" class="btn btn-primary btn-sm">View inventory</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">Awaiting receive</h5>
                                <p class="display-6"><t t-esc="awaiting_receive"/></p>
                                <p class="small text-muted">Dropped by DE, not yet scanned in</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">Receive scan</h5>
                                <p class="text-muted">Scan or enter AWB to take hub custody</p>
                                <a href="/my/hub/receive" class="btn btn-success btn-sm">Receive package</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">COD Banking</h5>
                                <p class="text-muted">Bank hub COD cash to company</p>
                                <a href="/my/hub/cod" class="btn btn-warning btn-sm">Manage COD cash</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_hub_cod" name="Hub COD Banking">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <a href="/my/hub" class="btn btn-link ps-0 mb-2"><i class="fa fa-arrow-left"/> Back</a>
                <h3 class="mb-3">Hub COD Cash → Company</h3>
                <t t-if="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>
                <t t-if="success">
                    <div class="alert alert-success"><t t-esc="success"/></div>
                </t>
                <div class="alert alert-info">
                    Unbanked deposits total: <strong><t t-esc="'%.2f' % unbanked_total"/></strong>
                </div>
                <t t-if="not unbanked">
                    <p class="alert alert-secondary">No unbanked hub deposits right now.</p>
                </t>
                <t t-else="">
                    <form action="/my/hub/cod" method="post" class="card shadow-sm p-4">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label class="form-label">Hub</label>
                            <select name="hub_id" class="form-select" required="1">
                                <t t-foreach="hubs" t-as="hub">
                                    <option t-att-value="hub.id"><t t-esc="hub.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Ref</th>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Hub</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="unbanked" t-as="dep">
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="deposit_ids" t-att-value="dep.id" checked="1"/>
                                            </td>
                                            <td><t t-esc="dep.name"/></td>
                                            <td><t t-esc="dep.transfer_date"/></td>
                                            <td><t t-esc="'%.2f' % dep.amount"/></td>
                                            <td><t t-esc="dep.hub_id.name or dep.to_account_id.name"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Note (optional)</label>
                            <input type="text" name="note" class="form-control" placeholder="Banking slip / reference"/>
                        </div>
                        <button type="submit" class="btn btn-warning w-100"
                                onclick="return confirm('Confirm banking selected deposits to company account?');">
                            <i class="fa fa-university"/> Bank Selected to Company
                        </button>
                    </form>
                </t>
                <t t-if="deposits">
                    <h5 class="mt-4">Recent hub deposits</h5>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="deposits" t-as="dep">
                                    <tr>
                                        <td><t t-esc="dep.name"/></td>
                                        <td><t t-esc="dep.transfer_date"/></td>
                                        <td><t t-esc="'%.2f' % dep.amount"/></td>
                                        <td>
                                            <t t-if="dep.hub_banking_transfer_id">
                                                <span class="badge text-bg-success">Banked</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge text-bg-warning">At hub</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_my_hub_receive" name="Hub Receive">
        <t t-call="portal.portal_layout">
            <div class="container py-3" style="max-width: 560px;">
                <a href="/my/hub" class="btn btn-link ps-0 mb-2"><i class="fa fa-arrow-left"/> Back</a>
                <h3>Receive at Hub</h3>
                <t t-if="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>
                <t t-if="success">
                    <div class="alert alert-success"><t t-esc="success"/></div>
                </t>
                <form action="/my/hub/receive" method="post" class="card shadow-sm p-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label">Hub</label>
                        <select name="hub_id" class="form-select" required="1">
                            <t t-foreach="hubs" t-as="hub">
                                <option t-att-value="hub.id"><t t-esc="hub.name"/></option>
                            </t>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">AWB / Scanned Code</label>
                        <div class="input-group">
                            <input type="text" name="awb" id="hub_receive_awb" class="form-control form-control-lg" placeholder="Enter or scan AWB" required="1" autofocus="1"/>
                            <button type="button" class="btn btn-primary btn-scan-qr" data-scan-target="#hub_receive_awb" title="Scan AWB QR Code">
                                <i class="fa fa-camera"/>
                            </button>
                        </div>
                        <div class="form-text">Or use the camera to scan the AWB QR code.</div>
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fa fa-check"/> Confirm Receive
                    </button>
                </form>
                <t t-call="keralariders_logistics.portal_qr_scanner_modal"/>
            </div>
        </t>
    </template>

    <template id="portal_my_hub_inventory" name="Hub Inventory">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <a href="/my/hub" class="btn btn-link ps-0 mb-2"><i class="fa fa-arrow-left"/> Back</a>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">Hub Inventory</h3>
                    <a href="/my/hub/receive" class="btn btn-success btn-sm">Receive AWB</a>
                </div>
                <t t-if="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>
                <t t-if="success">
                    <div class="alert alert-success"><t t-esc="success"/></div>
                </t>
                <t t-if="not shipments">
                    <p class="alert alert-info">No packages currently in hub custody.</p>
                </t>
                <t t-else="">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>AWB</th>
                                    <th>Hub</th>
                                    <th>Status</th>
                                    <th>To</th>
                                    <th>Dispatch</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="shipments" t-as="shipment">
                                    <tr>
                                        <td><t t-esc="shipment.name"/></td>
                                        <td><t t-esc="shipment.current_hub_id.name"/></td>
                                        <td><span class="badge text-bg-secondary"><t t-esc="dict(shipment.fields_get(allfields=['state'])['state']['selection']).get(shipment.state, shipment.state)"/></span></td>
                                        <td>
                                            <t t-esc="shipment.shipping_to_name"/><br/>
                                            <small class="text-muted"><t t-esc="shipment.shipping_to_zip"/></small>
                                        </td>
                                        <td>
                                            <form t-attf-action="/my/hub/dispatch/#{shipment.id}" method="post" class="d-flex flex-wrap gap-1">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <select name="delivery_executive_id" class="form-select form-select-sm" required="1" style="min-width:140px;">
                                                    <option value="">Select DE</option>
                                                    <t t-set="eligible_des" t-value="shipment_executives.get(shipment.id, executives)"/>
                                                    <t t-foreach="eligible_des" t-as="de">
                                                        <option t-att-value="de.id"
                                                                t-att-selected="shipment.active_leg_id and shipment.active_leg_id.assigned_de_id and de.id == shipment.active_leg_id.assigned_de_id.id">
                                                            <t t-esc="de.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <t t-set="default_for_delivery" t-value="'1' if (not shipment.active_leg_id or shipment.active_leg_id.operation_type == 'delivery') else '0'"/>
                                                <select name="for_delivery" class="form-select form-select-sm" style="min-width:120px;">
                                                    <option value="1" t-att-selected="default_for_delivery == '1'">Out for delivery</option>
                                                    <option value="0" t-att-selected="default_for_delivery == '0'">Hub transfer</option>
                                                </select>
                                                <button type="submit" class="btn btn-primary btn-sm">Dispatch</button>
                                            </form>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <t t-call="portal.pager"/>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_my_hub_pickups" name="Hub Pending Pickups">
        <t t-call="portal.portal_layout">
            <div class="container py-3">
                <a href="/my/hub" class="btn btn-link ps-0 mb-2"><i class="fa fa-arrow-left"/> Back</a>
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h3 class="mb-0">Assign Pickup</h3>
                        <p class="text-muted small mb-0">
                            Shipments awaiting pickup for your hub(s).
                            <t t-if="unassigned_count">
                                <span class="badge text-bg-warning ms-1"><t t-esc="unassigned_count"/> unassigned</span>
                            </t>
                        </p>
                    </div>
                </div>
                <t t-if="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>
                <t t-if="success">
                    <div class="alert alert-success"><t t-esc="success"/></div>
                </t>
                <t t-if="not shipments">
                    <p class="alert alert-info">No shipments awaiting pickup for your hubs.</p>
                </t>
                <t t-else="">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>AWB</th>
                                    <th>From / Seller</th>
                                    <th>Hub</th>
                                    <th>Status</th>
                                    <th>Current pickup DE</th>
                                    <th>Assign</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="shipments" t-as="shipment">
                                    <tr>
                                        <td>
                                            <strong><t t-esc="shipment.name"/></strong>
                                        </td>
                                        <td>
                                            <t t-esc="shipment.shipping_from_name or shipment.seller_id.name or ''"/><br/>
                                            <small class="text-muted">
                                                <t t-esc="shipment.shipping_from_address"/><br/>
                                                PIN <t t-esc="shipment.shipping_from_zip or '—'"/>
                                            </small>
                                        </td>
                                        <td><t t-esc="shipment.source_hub_id.name"/></td>
                                        <td>
                                            <span class="badge text-bg-secondary">
                                                <t t-esc="dict(shipment.fields_get(allfields=['state'])['state']['selection']).get(shipment.state, shipment.state)"/>
                                            </span>
                                        </td>
                                        <td>
                                            <t t-if="shipment.pickup_executive_id">
                                                <t t-esc="shipment.pickup_executive_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <span class="badge text-bg-warning">Unassigned</span>
                                            </t>
                                        </td>
                                        <td>
                                            <form t-attf-action="/my/hub/pickups/assign/#{shipment.id}" method="post" class="d-flex flex-wrap gap-1">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <select name="delivery_executive_id" class="form-select form-select-sm" required="1" style="min-width:160px;">
                                                    <option value="">Select DE</option>
                                                    <t t-set="eligible_des" t-value="shipment_executives.get(shipment.id)"/>
                                                    <t t-foreach="eligible_des or []" t-as="de">
                                                        <option t-att-value="de.id"
                                                                t-att-selected="shipment.pickup_executive_id and de.id == shipment.pickup_executive_id.id">
                                                            <t t-esc="de.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <button type="submit" class="btn btn-primary btn-sm">
                                                    <t t-if="shipment.pickup_executive_id">Re-assign</t>
                                                    <t t-else="">Assign</t>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <t t-call="portal.pager"/>
                </t>
            </div>
        </t>
    </template>

</odoo>
