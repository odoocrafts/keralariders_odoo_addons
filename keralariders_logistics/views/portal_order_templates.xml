<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Orders List -->
    <template id="portal_my_orders" name="My Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Orders</t>
            </t>
            <!-- Outside portal_searchbar so the buttons are not folded into
                 the mobile hamburger (#o_portal_navbar_content). -->
            <div class="kx-portal-order-actions d-grid d-md-flex flex-wrap gap-2 mb-3">
                <a href="/my/orders/manual" class="btn btn-primary">
                    <i class="fa fa-plus me-1"/> Add Order
                </a>
                <a href="/my/orders/new" class="btn btn-outline-primary">
                    <i class="fa fa-upload me-1"/> Bulk Upload Order
                </a>
            </div>
            
            <t t-if="error">
                <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
            </t>
            <t t-if="success">
                <div class="alert alert-success" role="alert"><t t-esc="success"/></div>
            </t>
            
            <t t-if="not orders">
                <p class="alert alert-info">You don't have any orders yet.</p>
            </t>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Order No</th>
                        <th>Order Date</th>
                        <th>Pickup Date</th>
                        <th>Shipments</th>
                        <th>Total Charges</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="orders" t-as="order">
                        <tr>
                            <td><a t-attf-href="/my/orders/#{order.id}"><span t-field="order.name"/></a></td>
                            <td><span t-field="order.order_date"/></td>
                            <td><span t-field="order.pickup_date"/></td>
                            <td><span t-field="order.shipment_count"/></td>
                            <td><span t-field="order.total_charges" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/></td>
                            <td>
                                <span class="badge bg-secondary">
                                    <t t-esc="dict(order.fields_get(allfields=['state'])['state']['selection'])[order.state]"/>
                                </span>
                            </td>
                            <td class="text-end">
                                <a t-if="order.state != 'draft'"
                                   t-attf-href="/my/orders/#{order.id}/print"
                                   class="btn btn-sm btn-outline-primary kx-print-awb"
                                   title="Print All AWBs">
                                    <i class="fa fa-print"/> Print
                                </a>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
            <t t-call="keralariders_logistics.portal_print_shipping_label_modal"/>
        </t>
    </template>

    <!-- Shared status pill for order / shipment. -->
    <template id="portal_status_pill" name="Portal Status Pill">
        <span t-attf-class="badge rounded-pill kx-status-pill #{pill_class} flex-shrink-0">
            <t t-esc="pill_label"/>
        </span>
    </template>

    <template id="portal_order_shipment_status" name="Order Shipment Status Pill">
        <t t-set="pill_label" t-value="dict(ship.fields_get(allfields=['state'])['state']['selection'])[ship.state]"/>
        <t t-set="pill_class" t-value="{
            'order_added': 'text-bg-secondary',
            'pickup_requested': 'text-bg-warning',
            'picked': 'text-bg-info',
            'in_transit': 'text-bg-info',
            'at_source_hub': 'text-bg-info',
            'at_central_hub': 'text-bg-info',
            'at_destination_hub': 'text-bg-info',
            'out_for_delivery': 'text-bg-warning',
            'delivery_failed': 'text-bg-danger',
            'delivered': 'text-bg-success',
            'cancelled': 'text-bg-danger',
            'return_requested': 'text-bg-secondary',
            'return_picked': 'text-bg-secondary',
            'returned': 'text-bg-dark',
        }.get(ship.state, 'text-bg-secondary')"/>
        <t t-call="keralariders_logistics.portal_status_pill"/>
    </template>

    <!-- Phone-only shipment card. Desktop keeps the compact table. -->
    <template id="portal_order_shipment_card" name="Order Detail Shipment Card">
        <article class="kx-shipment-card card shadow-sm mb-2">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                    <div class="kx-awb-block">
                        <t t-call="keralariders_logistics.portal_shipment_awb_ref">
                            <t t-set="shipment" t-value="ship"/>
                        </t>
                    </div>
                    <t t-call="keralariders_logistics.portal_order_shipment_status"/>
                </div>
                <div class="row g-3 kx-shipment-card-grid">
                    <div class="col-6">
                        <div class="text-muted small">Customer</div>
                        <div class="fw-semibold text-break"><span t-field="ship.shipping_to_name"/></div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Phone</div>
                        <div class="fw-semibold text-break"><span t-field="ship.shipping_to_mobile"/></div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Weight</div>
                        <div class="fw-semibold"><span t-field="ship.total_weight"/> kg</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Payment</div>
                        <div class="fw-semibold">
                            <span t-esc="dict(ship.fields_get(allfields=['order_payment_type'])['order_payment_type']['selection'])[ship.order_payment_type]"/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Charges</div>
                        <div class="fw-semibold">
                            <span t-field="ship.delivery_charges_total" t-options='{"widget": "monetary", "display_currency": ship.currency_id}'/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">Time to deliver</div>
                        <div class="fw-semibold">
                            <t t-if="ship.delivery_duration_display">
                                <span t-esc="ship.delivery_duration_display"/>
                            </t>
                            <t t-else="">—</t>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </template>

    <!-- Order Detail View -->
    <template id="portal_my_order_detail" name="Order Detail">
        <t t-call="portal.portal_layout">
            <t t-if="error">
                <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
            </t>
            <t t-if="success">
                <div class="alert alert-success" role="alert"><t t-esc="success"/></div>
            </t>

            <t t-set="order_status_label" t-value="dict(order.fields_get(allfields=['state'])['state']['selection'])[order.state]"/>
            <t t-set="order_status_class" t-value="{
                'draft': 'text-bg-secondary',
                'pickup_requested': 'text-bg-warning',
                'picked': 'text-bg-info',
                'partial': 'text-bg-dark',
                'delivered': 'text-bg-success',
                'cancelled': 'text-bg-danger',
            }.get(order.state, 'text-bg-primary')"/>

            <div class="card shadow-sm mb-4 kx-portal-order-detail">
                <div class="card-header bg-white py-3 kx-order-detail-header">
                    <div class="d-flex flex-column flex-md-row align-items-md-center gap-2">
                        <div class="d-flex justify-content-between align-items-center gap-2 kx-order-detail-title-row flex-grow-1">
                            <h4 class="mb-0 text-break kx-order-detail-title">
                                Order: <t t-esc="order.name"/>
                            </h4>
                            <t t-call="keralariders_logistics.portal_status_pill">
                                <t t-set="pill_label" t-value="order_status_label"/>
                                <t t-set="pill_class" t-value="order_status_class"/>
                            </t>
                        </div>
                        <div class="d-grid d-md-block kx-order-detail-actions flex-shrink-0">
                            <a t-if="order.state == 'draft'"
                               t-attf-href="/my/orders/#{order.id}/shipments/new"
                               class="btn btn-primary">
                                <i class="fa fa-plus me-1"/> Add Shipment
                            </a>
                            <a t-if="order.state != 'draft'"
                               t-attf-href="/my/orders/#{order.id}/print"
                               class="btn btn-outline-primary kx-print-awb">
                                <i class="fa fa-print me-1"/> Print AWBs
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-4 kx-order-meta">
                        <div class="col-6 col-md-3">
                            <div class="text-muted text-uppercase fw-semibold kx-order-meta-label">Order Date</div>
                            <div class="fw-semibold"><span t-field="order.order_date"/></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted text-uppercase fw-semibold kx-order-meta-label">Pickup Date</div>
                            <div class="fw-semibold"><span t-field="order.pickup_date"/></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted text-uppercase fw-semibold kx-order-meta-label">Total Shipments</div>
                            <div class="fw-semibold"><span t-field="order.shipment_count"/></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-muted text-uppercase fw-semibold kx-order-meta-label">Total Charges</div>
                            <div class="fw-bold text-primary fs-5 mb-0">
                                <span t-field="order.total_charges" t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                            </div>
                        </div>
                    </div>

                    <t t-if="order.state == 'draft'">
                        <div t-attf-class="alert #{'alert-danger' if wallet.balance &lt; order.total_charges else 'alert-success'} d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3">
                            <div>
                                <strong>Wallet Balance: </strong> <span t-field="wallet.balance" t-options='{"widget": "monetary", "display_currency": wallet.currency_id}'/>
                                <t t-if="wallet.balance &lt; order.total_charges">
                                    <br/><small>Insufficient balance. Please recharge your wallet to proceed.</small>
                                </t>
                            </div>
                            <div class="d-grid d-sm-block">
                                <t t-if="wallet.balance &lt; order.total_charges">
                                    <a href="/my/wallet" class="btn btn-warning">Recharge Wallet</a>
                                </t>
                                <t t-else="">
                                    <form action="/my/orders/request_pickup" method="post"
                                          onsubmit="var b=this.querySelector('button[type=submit]'); if(b){b.disabled=true;}">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="order_id" t-att-value="order.id"/>
                                        <input type="hidden" name="pickup_confirm_token" t-att-value="pickup_confirm_token"/>
                                        <button type="submit" class="btn btn-success w-100"><i class="fa fa-truck me-1"/> Confirm &amp; Request Pickup</button>
                                    </form>
                                </t>
                            </div>
                        </div>
                    </t>

                    <h5 class="mt-4 mb-3">Shipments Included in this Order</h5>
                    <div class="d-md-none kx-shipment-cards">
                        <t t-foreach="order.shipment_ids" t-as="ship">
                            <t t-call="keralariders_logistics.portal_order_shipment_card"/>
                        </t>
                    </div>
                    <div class="table-responsive d-none d-md-block kx-shipment-table-wrap">
                        <table class="table table-sm table-striped align-middle kx-shipment-table">
                            <thead>
                                <tr>
                                    <th>AWB / Ref</th>
                                    <th>Customer Name</th>
                                    <th>Phone</th>
                                    <th>Weight (Kg)</th>
                                    <th>Payment Type</th>
                                    <th>Charges</th>
                                    <th>Status</th>
                                    <th>Time to Deliver</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="order.shipment_ids" t-as="ship">
                                    <tr>
                                        <td>
                                            <div class="kx-awb-block">
                                                <t t-call="keralariders_logistics.portal_shipment_awb_ref">
                                                    <t t-set="shipment" t-value="ship"/>
                                                </t>
                                            </div>
                                        </td>
                                        <td><span t-field="ship.shipping_to_name"/></td>
                                        <td><span t-field="ship.shipping_to_mobile"/></td>
                                        <td><span t-field="ship.total_weight"/></td>
                                        <td><span t-esc="dict(ship.fields_get(allfields=['order_payment_type'])['order_payment_type']['selection'])[ship.order_payment_type]"/></td>
                                        <td><span t-field="ship.delivery_charges_total" t-options='{"widget": "monetary", "display_currency": ship.currency_id}'/></td>
                                        <td>
                                            <t t-call="keralariders_logistics.portal_order_shipment_status"/>
                                        </td>
                                        <td>
                                            <t t-if="ship.delivery_duration_display">
                                                <span t-esc="ship.delivery_duration_display"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <t t-call="keralariders_logistics.portal_print_shipping_label_modal"/>
        </t>
    </template>

    <!-- Manual single-order form (no Excel). First shipment is required;
         more can be added from the order detail while the order is a draft. -->
    <template id="portal_my_order_manual" name="Add Order">
        <t t-call="portal.portal_layout">
            <t t-if="error">
                <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
            </t>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0">Add Order</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Create an order with its first shipment. You can add more
                        shipments on the next page before requesting pickup.
                    </p>
                    <form action="/my/orders/create" method="post" class="kx-portal-shipment-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-4">
                            <label for="pickup_date" class="form-label fw-bold">Pickup Date</label>
                            <input type="date" name="pickup_date" id="pickup_date" class="form-control"
                                   required="1"
                                   t-att-value="datetime.date.today().strftime('%Y-%m-%d')"
                                   t-att-min="earliest_pickup_date if uses_indiapost else None"/>
                        </div>
                        <t t-call="keralariders_logistics.portal_shipment_form_fields"/>
                        <div class="text-end border-top pt-3">
                            <a href="/my/orders" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">Create Order</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- Add another shipment to a draft order -->
    <template id="portal_my_order_shipment_new" name="Add Shipment to Order">
        <t t-call="portal.portal_layout">
            <t t-if="error">
                <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
            </t>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0">Add Shipment to <t t-esc="order.name"/></h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        This shipment will be added to order <strong><t t-esc="order.name"/></strong>
                        (pickup <span t-field="order.pickup_date"/>).
                    </p>
                    <form t-attf-action="/my/orders/#{order.id}/shipments/create" method="post" class="kx-portal-shipment-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <t t-call="keralariders_logistics.portal_shipment_form_fields"/>
                        <div class="text-end border-top pt-3">
                            <a t-attf-href="/my/orders/#{order.id}" class="btn btn-secondary me-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">Add Shipment</button>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- New Order Form (Bulk Upload) -->
    <template id="portal_my_order_new" name="New Order">
        <t t-call="portal.portal_layout">
            <t t-if="error">
                <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
            </t>
            
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0">Create New Bulk Order</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <form action="/my/orders/bulk_upload" method="post" enctype="multipart/form-data"
                                  onsubmit="var b=this.querySelector('button[type=submit]'); if(b){b.disabled=true;}">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="bulk_upload_token" t-att-value="bulk_upload_token"/>
                                
                                <div class="mb-4">
                                    <label for="pickup_date" class="form-label fw-bold">Pickup Date</label>
                                    <input type="date" name="pickup_date" id="pickup_date" class="form-control" required="1" t-att-value="datetime.date.today().strftime('%Y-%m-%d')"/>
                                </div>

                                <div t-if="uses_indiapost" class="mb-4">
                                    <label class="form-label fw-bold">India Post service</label>
                                    <div class="d-flex flex-wrap gap-4">
                                        <t t-foreach="indiapost_article_types" t-as="product">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio"
                                                       t-att-id="'kx_bulk_article_%s' % product['code']"
                                                       name="indiapost_article_type"
                                                       t-att-value="product['code']"
                                                       t-att-checked="'checked' if product['code'] == 'SP' else None"/>
                                                <label class="form-check-label"
                                                       t-att-for="'kx_bulk_article_%s' % product['code']">
                                                    <t t-esc="product['label']"/>
                                                    <span t-if="product['code'] == 'BP'" class="text-muted small">
                                                        (normal parcel)
                                                    </span>
                                                </label>
                                            </div>
                                        </t>
                                    </div>
                                    <p class="text-muted small mb-0 mt-2">
                                        This choice applies to every row in the CSV. Speed Post and
                                        Business Parcel are priced and booked separately.
                                    </p>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">1. Download Template</label>
                                    <p class="text-muted small">
                                        Please use our standard CSV template. Columns marked
                                        <strong>* (mandatory)</strong> — Phone Number, Address, and Pincode —
                                        are required for every row.
                                    </p>
                                    <a href="/my/shipments/bulk_upload/template" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-download me-1"/> Download CSV Template
                                    </a>
                                </div>
                                
                                <div class="mb-4">
                                    <label for="csv_file" class="form-label fw-bold">2. Upload Filled Template</label>
                                    <input class="form-control" type="file" id="csv_file" name="csv_file" accept=".csv" required="1"/>
                                </div>
                                
                                <div class="text-end border-top pt-3">
                                    <a href="/my/orders" class="btn btn-secondary me-2">Cancel</a>
                                    <button type="submit" class="btn btn-primary">Preview &amp; Calculate Charges</button>
                                </div>
                            </form>
                        </div>
                        <div class="col-md-4">
                            <div class="alert alert-info">
                                <h5>How it works:</h5>
                                <ol class="small ps-3 mb-0">
                                    <li class="mb-2">Download the CSV template.</li>
                                    <li class="mb-2">Fill in your shipments' details carefully. Do not change the headers. <strong>Phone, Address, and Pincode are mandatory</strong> for every row.</li>
                                    <li t-if="uses_indiapost" class="mb-2">
                                        Choose <strong>Speed Post</strong> or
                                        <strong>Business Parcel</strong> above.
                                        The selected service is used for every
                                        row: charges, booking, and barcodes
                                        (EY for Speed Post, CX for Business Parcel).
                                        Length, breadth and height are required
                                        because India Post prices on package size.
                                    </li>
                                    <li class="mb-2">Upload the file here.</li>
                                    <li class="mb-2">We will parse the file and calculate the total delivery charges. Rows missing required fields are skipped with an error summary.</li>
                                    <li class="mb-0">You can then review the charges, recharge your wallet if needed, and confirm the pickup request!</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
