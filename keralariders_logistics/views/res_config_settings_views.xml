<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.keralariders_logistics</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Logistics" string="Logistics" name="keralariders_logistics" groups="base.group_user">
                    <block title="Payment Settings" name="payment_settings_setting_container">
                        <setting id="logistics_upi" string="Logistics UPI ID" help="UPI ID for seller wallet recharges">
                            <field name="logistics_upi_id"/>
                        </setting>
                        <setting id="company_cod_account" string="Company COD Account"
                                 help="Receives hub banking deposits and is the source for seller COD clearance">
                            <field name="company_cod_account_id" options="{'no_create': False}"/>
                        </setting>
                    </block>

                    <block title="India Post (Department of Posts)"
                           name="indiapost_setting_container">
                        <setting id="indiapost_enable" string="Enable India Post"
                                 help="Master switch. When off no API call is made and the rate calculator falls back to the weight slab table.">
                            <field name="indiapost_enabled"/>
                            <div class="content-group mt-2" invisible="not indiapost_enabled">
                                <div class="row">
                                    <label for="indiapost_environment" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_environment"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_base_url" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_base_url"/>
                                </div>
                                <div class="alert alert-warning mt-2 mb-0" role="alert"
                                     invisible="indiapost_environment != 'production'">
                                    Production uses
                                    https://app.indiapost.gov.in/beextcustomer
                                    and switches barcode allocation to
                                    production ranges. Confirm India Post has
                                    whitelisted this server's public IP before
                                    going live.
                                </div>
                                <button name="action_indiapost_test_connection"
                                        type="object" string="Test Connection"
                                        icon="fa-plug" class="btn-link mt-2"/>
                            </div>
                        </setting>

                        <setting id="indiapost_credentials" string="Credentials"
                                 help="Bulk customer account issued by India Post. The username is the same value as the bulk customer id."
                                 invisible="not indiapost_enabled">
                            <div class="content-group">
                                <div class="row">
                                    <label for="indiapost_username" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_username"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_password" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_password" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_customer_id" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_customer_id"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sp_contract_id" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sp_contract_id"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_bp_contract_id" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_bp_contract_id"/>
                                </div>
                                <div class="text-muted mt-2">
                                    India Post contracts a bulk customer per
                                    service, so each product has its own
                                    contract id and a booking carries the one
                                    matching the product on the shipment.
                                </div>
                                <div class="alert alert-info mt-2 mb-0" role="alert">
                                    In the UAT sandbox every booking is still
                                    rejected with "Contract validation failed:
                                    Contract … has no service_type defined",
                                    and the same message comes back for a
                                    contract id that does not exist at all — so
                                    the sandbox cannot see the service type of
                                    any contract and booking stays blocked
                                    there whatever is entered here. Business
                                    Parcel rates are not loaded in the sandbox
                                    either, so quoting Business Parcel through
                                    the Speed Post tariff URL is refused with
                                    "No matching domestic speed post tariff
                                    found … product: BUSINESS_PARCEL". Production
                                    prices Business Parcel on
                                    /v1/business-parcel-tariff/calculate.
                                    Speed Post tariffs, labels and tracking all
                                    work in both environments.
                                </div>
                            </div>
                        </setting>

                        <setting id="indiapost_consignor" string="Consignor of Record"
                                 help="KeralaXpress books as a single consignor. The seller appears as the pickup address and as the return address, so undelivered articles go back to the seller."
                                 invisible="not indiapost_enabled">
                            <div class="content-group">
                                <div class="row">
                                    <label for="indiapost_sender_name" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_name"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_company" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_company"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_address" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_address" widget="text"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_city" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_city"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_state" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_state"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_pincode" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_pincode"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_mobile" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_mobile"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_email" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_email"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_sender_gstin" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_sender_gstin"/>
                                </div>
                                <div class="text-muted mt-2">
                                    Names, company, city and state must each be
                                    3 to 80 characters and the mobile exactly 10
                                    digits starting 6-9. India Post does not
                                    enforce this itself, so it is checked here.
                                </div>
                            </div>
                        </setting>

                        <setting id="indiapost_label" string="Labels and Booking Office"
                                 invisible="not indiapost_enabled">
                            <div class="content-group">
                                <div class="row">
                                    <label for="indiapost_booking_office_name" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_booking_office_name"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_booking_office_pin" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_booking_office_pin"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_label_size" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_label_size"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_transmission_mode" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_transmission_mode"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="indiapost_operations" string="Rates, Caching and Pickup"
                                 invisible="not indiapost_enabled">
                            <div class="content-group">
                                <div class="row">
                                    <label for="indiapost_tariff_cache_minutes" class="col-lg-6 o_light_label"/>
                                    <field name="indiapost_tariff_cache_minutes"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_office_cache_days" class="col-lg-6 o_light_label"/>
                                    <field name="indiapost_office_cache_days"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_request_timeout" class="col-lg-6 o_light_label"/>
                                    <field name="indiapost_request_timeout"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_pickup_lead_days" class="col-lg-6 o_light_label"/>
                                    <field name="indiapost_pickup_lead_days"/>
                                </div>
                                <div class="row">
                                    <label for="indiapost_quote_markup_percent" class="col-lg-6 o_light_label"/>
                                    <field name="indiapost_quote_markup_percent"/>
                                </div>
                                <div class="row">
                                    <field name="indiapost_default_pod"/>
                                    <label for="indiapost_default_pod" class="o_light_label ms-2"/>
                                </div>
                            </div>
                        </setting>

                        <setting id="indiapost_webhooks" string="Inbound Webhooks"
                                 help="Register these exact URLs on India Post's Customer Self-Service Portal under Event Configuration. India Post POSTs events here; we never call these addresses."
                                 invisible="not indiapost_enabled">
                            <div class="content-group">
                                <div class="row">
                                    <field name="indiapost_webhooks_enabled"/>
                                    <label for="indiapost_webhooks_enabled" class="o_light_label ms-2"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="indiapost_booking_webhook_url" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_booking_webhook_url" readonly="1"/>
                                </div>
                                <div class="text-muted">
                                    Booking events (booked, accepted, rejected, label).
                                </div>
                                <div class="row mt-2">
                                    <label for="indiapost_other_webhook_url" class="col-lg-4 o_light_label"/>
                                    <field name="indiapost_other_webhook_url" readonly="1"/>
                                </div>
                                <div class="text-muted">
                                    Tracking and other non-booking events. Built from
                                    this database's web base URL so staging and
                                    production stay distinct. Paths are not
                                    configurable: they are already registered
                                    with India Post.
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_logistics_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'keralariders_logistics', 'bin_size': False}</field>
    </record>


</odoo>
