<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_delivery_executive_tree" model="ir.ui.view">
        <field name="name">logistics.delivery.executive.tree</field>
        <field name="model">logistics.delivery.executive</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mobile"/>
                <field name="vehicle_type"/>
                <field name="vehicle_number"/>
                <field name="assigned_region"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_delivery_executive_form" model="ir.ui.view">
        <field name="name">logistics.delivery.executive.form</field>
        <field name="model">logistics.delivery.executive</field>
        <field name="arch" type="xml">
            <form string="Delivery Executive">
                <header>
                    <button name="action_grant_portal_access" string="Grant Portal Access" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- <button name="action_view_deliveries" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                        </button> -->
                    </div>
                    <div class="d-flex flex-column flex-sm-row align-items-center">
                        <div class="ms-2 p-0">
                            <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'size': [130,130], 'img_class': 'rounded border'}"/>
                            <field name="avatar_128" invisible="1"/> <!-- Needed in contact_image widget -->
                        </div>
                        <div class="col-12 col-sm-6 col-md-7 col-lg-8 px-4">
                            <div class="oe_title mw-100 ps-0 pe-sm-2">
                                <h1 class="d-flex flex-row align-items-center">
                                    <field name="name" placeholder="Executive's Name" required="True" style="font-size: min(4vw, 2.6rem);"/>
                                </h1>
                            </div>
                        </div>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="aadhaar_number"/>
                            <field name="driving_license"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Vehicle Details">
                            <field name="vehicle_type"/>
                            <field name="vehicle_number"/>
                            <field name="assigned_region"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Address">
                        <field name="address" nolabel="1" placeholder="Full address..."/>
                    </group>
                    <group>
                        <group string="UPI &amp; Cash Accounts">
                            <field name="default_upi_account_id" context="{'default_account_type': 'bank'}" domain="[('account_type', '=', 'bank')]"/>
                            <field name="default_cash_account_id" context="{'default_account_type': 'cash'}" domain="[('account_type', '=', 'cash')]"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_delivery_executive_kanban" model="ir.ui.view">
        <field name="name">logistics.delivery.executive.kanban</field>
        <field name="model">logistics.delivery.executive</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    records_draggable="0">

                <field name="name"/>
                <field name="avatar_128"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="aadhaar_number"/>
                <field name="vehicle_type"/>
                <field name="vehicle_number"/>
                <field name="assigned_region"/>
                <field name="active"/>

                <templates>
                    <t t-name="card" class="flex-row">

                        <aside class="o_kanban_aside_full">
                            <field name="avatar_128"
                                widget="image"
                                options="{'zoom': true, 'zoom_delay': 1000, 'img_class': 'object-fit-cover w-100 h-100'}"
                                class="d-block position-relative h-100"/>
                        </aside>

                        <main class="ps-2 flex-grow-1">

                            <div class="d-flex justify-content-between align-items-center">
                                <strong>
                                    <field name="name"/>
                                </strong>
                            </div>

                            <div class="text-muted mt-1">
                                <i class="fa fa-phone me-1"/>
                                <field name="mobile"/>
                            </div>

                            <div class="text-muted">
                                <i class="fa fa-envelope me-1"/>
                                <field name="email"/>
                            </div>

                            <div class="text-muted mt-1">
                                <i class="fa fa-truck me-1"/>
                                <span invisible="not vehicle_number">
                                    <field name="vehicle_number"/>
                                </span>
                            </div>

                            <div class="text-muted">
                                <i class="fa fa-map-marker me-1"/>
                                <field name="assigned_region"/>
                            </div>

                            <div class="d-flex gap-2 mt-3">

                                <button name="action_view_pending_shipments"
                                        type="object"
                                        class="btn btn-outline-info btn-sm flex-fill">
                                    <i class="fa fa-truck me-1"/>
                                    <field name="pending_shipments_count"/>
                                    Pending
                                </button>

                                <button name="action_view_delivered_shipments"
                                        type="object"
                                        class="btn btn-outline-success btn-sm flex-fill">
                                    <i class="fa fa-clock-o me-1"/>
                                    <field name="delivered_shipments_count"/>
                                    Delivered
                                </button>

                            </div>

                        </main>

                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_delivery_executive_search" model="ir.ui.view">
        <field name="name">logistics.delivery.executive.search</field>
        <field name="model">logistics.delivery.executive</field>
        <field name="arch" type="xml">
            <search string="Search Executives">
                <field name="name"/>
                <field name="mobile"/>
                <field name="assigned_region"/>
                <field name="vehicle_number"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Vehicle Type" name="group_vehicle" context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Region" name="group_region" context="{'group_by': 'assigned_region'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_delivery_executive" model="ir.actions.act_window">
        <field name="name">Delivery Executives</field>
        <field name="res_model">logistics.delivery.executive</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a delivery executive
            </p>
            <p>Manage your delivery fleet and assign regions.</p>
        </field>
    </record>

    <menuitem id="menu_logistics_delivery_executive"
                name="Delivery Executives"
                parent="menu_logistics_root"
                action="action_delivery_executive"
                sequence="40"
    />
</odoo>