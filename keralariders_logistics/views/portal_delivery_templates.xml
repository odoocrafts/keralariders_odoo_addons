<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal Home Entry -->
    <template id="portal_my_home_delivery_executive" name="Show Delivery Executive Portal Entries" customize_show="True" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="is_delivery_executive">
                <t t-call="keralariders_logistics.logistics_portal_card">
                    <t t-set="title">My Tasks</t>
                    <t t-set="url" t-value="'/my/deliveries'"/>
                    <t t-set="count_text" t-value="assigned_shipment_count if assigned_shipment_count else '0'"/>
                    <t t-set="icon" t-value="'/keralariders_logistics/static/src/img/shipment.svg'"/>
                    <t t-set="text">Assigned legs &amp; deliveries — scan QR to claim</t>
                </t>
                <t t-call="keralariders_logistics.logistics_portal_card">
                    <t t-set="title">COD Hub Deposit</t>
                    <t t-set="url" t-value="'/my/cod_deposit'"/>
                    <t t-set="count_text" t-value="cod_undeposited_count if cod_undeposited_count else '0'"/>
                    <t t-set="icon" t-value="'/keralariders_logistics/static/src/img/shipment.svg'"/>
                    <t t-set="text">Deposit COD cash at a hub</t>
                </t>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_docs')]" position="after">
            <t t-if="is_delivery_executive">
                <div class="mt-4 text-center w-100">
                    <button type="button" class="btn btn-primary btn-lg shadow-sm rounded-pill px-5 py-3 btn-scan-qr">
                        <i class="fa fa-camera fa-lg me-2"/> Scan AWB QR Code
                    </button>
                </div>
                <t t-call="keralariders_logistics.portal_qr_scanner_modal"/>
            </t>
        </xpath>
    </template>

    <template id="portal_qr_scanner_modal" name="QR Scanner Modal">
        <!-- Scanner Modal -->
        <div class="modal fade" id="qrScannerModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="fa fa-qrcode"/> Scan AWB</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div id="qr-reader" style="width: 100%;"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
        
        <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
        <script type="text/javascript">
            document.addEventListener("DOMContentLoaded", function() {
                var btnScanList = document.querySelectorAll('.btn-scan-qr');
                if(btnScanList.length > 0) {
                    let html5QrCode = null;
                    let scanTargetSelector = null;
                    let scanAutoSubmit = false;

                    function extractAwb(decodedText) {
                        if (!decodedText) {
                            return '';
                        }
                        try {
                            if (decodedText.indexOf('track?id=') !== -1 || decodedText.indexOf('track/?id=') !== -1) {
                                var url = new URL(decodedText, window.location.origin);
                                var id = url.searchParams.get('id');
                                if (id) {
                                    return id;
                                }
                            }
                            if (decodedText.indexOf('/my/delivery/') !== -1) {
                                var parts = decodedText.split('/').filter(Boolean);
                                return parts[parts.length - 1] || decodedText;
                            }
                            if (decodedText.indexOf('http') === 0) {
                                var httpUrl = new URL(decodedText);
                                var pathParts = httpUrl.pathname.split('/').filter(Boolean);
                                return pathParts[pathParts.length - 1] || decodedText;
                            }
                        } catch (e) {
                            // fall through to raw text
                        }
                        return decodedText;
                    }

                    function hideQrModal() {
                        var modalEl = document.getElementById('qrScannerModal');
                        if (typeof $ !== 'undefined') {
                            $('#qrScannerModal').modal('hide');
                        } else if (typeof bootstrap !== 'undefined' &amp;&amp; modalEl) {
                            var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                            modal.hide();
                        }
                    }

                    function onScanSuccess(decodedText, decodedResult) {
                        if (html5QrCode) {
                            html5QrCode.stop().then(() => html5QrCode.clear()).catch(e => console.error(e));
                        }
                        if (scanTargetSelector) {
                            var input = document.querySelector(scanTargetSelector);
                            if (input) {
                                input.value = extractAwb(decodedText);
                                input.dispatchEvent(new Event('input', {bubbles: true}));
                                input.dispatchEvent(new Event('change', {bubbles: true}));
                                hideQrModal();
                                var form = input.closest('form');
                                if (scanAutoSubmit &amp;&amp; form) {
                                    form.submit();
                                    return;
                                }
                                var submitBtn = form ? form.querySelector('button[type="submit"]') : null;
                                if (submitBtn) {
                                    submitBtn.focus();
                                } else {
                                    input.focus();
                                }
                                return;
                            }
                        }
                        if(decodedText.includes('/my/delivery/')) {
                            window.location.href = decodedText;
                        } else if (decodedText.startsWith('http')) {
                            window.location.href = decodedText;
                        } else {
                            window.location.href = '/track?id=' + encodeURIComponent(decodedText);
                        }
                    }
                    
                    btnScanList.forEach(function(btnScan) {
                        btnScan.addEventListener('click', function(e) {
                            e.preventDefault();
                            scanTargetSelector = btnScan.getAttribute('data-scan-target') || null;
                            scanAutoSubmit = btnScan.getAttribute('data-scan-auto-submit') === '1';
                            if (typeof $ !== 'undefined') {
                                $('#qrScannerModal').modal('show');
                            } else if (typeof bootstrap !== 'undefined') {
                                var modalEl = document.getElementById('qrScannerModal');
                                var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                                modal.show();
                            }
                            
                            setTimeout(function() {
                                if (!html5QrCode) {
                                    html5QrCode = new Html5Qrcode("qr-reader");
                                }
                                html5QrCode.start(
                                    { facingMode: "environment" },
                                    { fps: 10, qrbox: {width: 250, height: 250} },
                                    onScanSuccess,
                                    function(errorMessage) {
                                        // parse error, ignore and keep scanning
                                    }
                                ).catch(function(err) {
                                    console.error("Camera start failed:", err);
                                    document.getElementById('qr-reader').innerHTML = '<div class="alert alert-danger m-3">Could not access camera. Please ensure permissions are granted.</div>';
                                });
                            }, 500);
                        });
                    });
                    
                    var modalEl = document.getElementById('qrScannerModal');
                    if (modalEl) {
                        modalEl.addEventListener('hidden.bs.modal', function () {
                            if (html5QrCode) {
                                html5QrCode.stop().then(() => html5QrCode.clear()).catch(e => console.error(e));
                            }
                        });
                    }
                }
            });
        </script>
    </template>

    <!-- Breadcrumbs -->
    <template id="portal_breadcrumbs_delivery_executive" name="Portal Breadcrumbs Delivery" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'deliveries'" t-attf-class="breadcrumb-item #{'active ' if not shipment else ''}">
                <a t-if="shipment" t-attf-href="/my/deliveries?{{ keep_query() }}">My Deliveries</a>
                <t t-else="">My Deliveries</t>
            </li>
            <li t-if="shipment and page_name == 'deliveries'" class="breadcrumb-item active">
                <t t-esc="shipment.name"/>
            </li>
        </xpath>
    </template>

    <!-- Deliveries List -->
    <template id="portal_my_deliveries" name="My Deliveries">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Tasks</t>
                <div class="form-inline ms-auto d-flex gap-2">
                    <form action="/track" method="get" class="d-flex gap-1">
                        <input type="text" name="id" class="form-control form-control-sm" placeholder="Enter AWB" style="min-width:140px;"/>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Open</button>
                    </form>
                    <button type="button" class="btn btn-primary btn-scan-qr">
                        <i class="fa fa-camera"/> Scan AWB
                    </button>
                </div>
            </t>
            <t t-call="keralariders_logistics.portal_qr_scanner_modal"/>
            
            <t t-if="error">
                <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
            </t>
            <t t-if="success">
                <div class="alert alert-success" role="alert"><t t-esc="success"/></div>
            </t>
            
            <t t-if="not shipments">
                <p class="alert alert-info">You don't have any pending deliveries assigned.</p>
            </t>
            <t t-if="shipments" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>AWB / Ref</th>
                        <th>Date</th>
                        <th>Shipping To</th>
                        <th>Task / Leg</th>
                        <th>Weight</th>
                        <th>Payment Type</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="shipments" t-as="shipment">
                        <tr>
                            <td><a t-attf-href="/my/delivery/#{shipment.id}"><span t-field="shipment.name"/></a></td>
                            <td><span t-field="shipment.order_date"/></td>
                            <td><span t-field="shipment.shipping_to_name"/><br/><small class="text-muted"><span t-field="shipment.shipping_to_mobile"/></small></td>
                            <td>
                                <t t-set="leg_label" t-value="shipment.get_active_leg_label()"/>
                                <span t-if="leg_label" class="badge text-bg-info text-wrap"><t t-esc="leg_label"/></span>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td><span t-field="shipment.total_weight"/> kg</td>
                            <td>
                                <span t-if="shipment.order_payment_type == 'cod'" class="badge bg-warning text-dark">COD: <span t-field="shipment.cod_amount"/></span>
                                <span t-else="" class="badge bg-success">Prepaid</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">
                                    <t t-esc="dict(shipment.fields_get(allfields=['state'])['state']['selection'])[shipment.state]"/>
                                </span>
                            </td>
                            <td class="text-end">
                                <a t-attf-href="/my/delivery/#{shipment.id}" class="btn btn-sm btn-primary">View Details</a>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Delivery Detail &amp; Mark Delivered -->
    <template id="portal_my_delivery_detail" name="Delivery Detail">
        <t t-call="portal.portal_layout">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h4 class="mb-0">Delivery Details - <t t-esc="shipment.name"/></h4>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span t-if="active_leg_label" class="badge text-bg-info fs-6"><t t-esc="active_leg_label"/></span>
                        <span class="badge bg-secondary fs-6"><t t-esc="dict(shipment.fields_get(allfields=['state'])['state']['selection'])[shipment.state]"/></span>
                    </div>
                </div>
                <div class="card-body">
                    <t t-if="error">
                        <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
                    </t>
                    <t t-if="success">
                        <div class="alert alert-success" role="alert"><t t-esc="success"/></div>
                    </t>

                    <t t-if="shipment.is_return_journey">
                        <div class="alert alert-info" role="alert">
                            <strong>Free return journey</strong> — pick up from customer, move through hubs, deliver back to seller.
                            No wallet charge.
                        </div>
                    </t>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <t t-if="shipment.is_return_journey and shipment.state == 'out_for_delivery'">
                                <h5>Deliver To Seller</h5>
                                <p>
                                    <strong>Name:</strong> <span t-field="shipment.shipping_from_name"/><br/>
                                    <strong>Address:</strong> <span t-field="shipment.shipping_from_address"/><br/>
                                    <span t-field="shipment.shipping_from_district_id.name"/>, <span t-field="shipment.shipping_from_state_id.name"/> - <span t-field="shipment.shipping_from_zip"/>
                                </p>
                            </t>
                            <t t-else="">
                                <h5>
                                    <t t-if="shipment.is_return_journey">Customer (Return Pickup)</t>
                                    <t t-else="">Customer Information</t>
                                </h5>
                                <p>
                                    <strong>Name:</strong> <span t-field="shipment.shipping_to_name"/><br/>
                                    <strong>Mobile:</strong> <span t-field="shipment.shipping_to_mobile"/><br/>
                                    <strong>Address:</strong> <span t-field="shipment.shipping_to_address"/><br/>
                                    <span t-field="shipment.shipping_to_district_id.name"/>, <span t-field="shipment.shipping_to_state_id.name"/> - <span t-field="shipment.shipping_to_zip"/>
                                </p>
                            </t>
                        </div>
                        <div class="col-md-6">
                            <h5>Package Information</h5>
                            <p>
                                <strong>Weight:</strong> <span t-field="shipment.total_weight"/> kg<br/>
                                <strong>Description:</strong> <span t-field="shipment.item_description"/><br/>
                                <strong>Payment Type:</strong>
                                <t t-if="shipment.is_return_journey">
                                    <span class="text-success fw-bold">Free return (no charge)</span>
                                </t>
                                <t t-else="">
                                    <span t-if="shipment.order_payment_type == 'cod'" class="text-danger fw-bold">COD (Collect <span t-field="shipment.cod_amount"/>)</span>
                                    <span t-else="" class="text-success fw-bold">Prepaid</span>
                                </t>
                                <br/>
                                <strong>Custody:</strong> <span t-field="shipment.custodian_type"/><br/>
                                <strong>Current Hub:</strong> <span t-field="shipment.current_hub_id"/><br/>
                                <t t-if="active_leg">
                                    <strong>Active leg:</strong> <t t-esc="active_leg_label or active_leg.name"/><br/>
                                    <strong>Leg state:</strong> <t t-esc="active_leg.state"/>
                                    <t t-if="active_leg.assigned_de_id"> · <t t-esc="active_leg.assigned_de_id.name"/></t>
                                </t>
                            </p>
                        </div>
                    </div>

                    <t t-if="shipment.state in ['pickup_requested', 'order_added']">
                        <hr/>
                        <h4 class="mb-3 text-primary">Confirm Pickup</h4>
                        <form t-attf-action="/my/delivery/#{shipment.id}/mark_picked" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="scanned_code" t-att-value="shipment.name"/>
                            <button type="submit" class="btn btn-lg btn-primary w-100 fw-bold shadow-sm"
                                    onclick="return confirm('Confirm pickup scan for this shipment?');">
                                <i class="fa fa-hand-paper-o"/> MARK AS PICKED
                            </button>
                        </form>
                    </t>

                    <t t-if="shipment.state == 'return_requested'">
                        <hr/>
                        <h4 class="mb-3 text-primary">Confirm Return Pickup (from Customer)</h4>
                        <p class="text-muted small mb-3">Free return — no wallet charge. After pickup, drop at hub for custody handoff.</p>
                        <form t-attf-action="/my/delivery/#{shipment.id}/mark_picked" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="scanned_code" t-att-value="shipment.name"/>
                            <button type="submit" class="btn btn-lg btn-primary w-100 fw-bold shadow-sm"
                                    onclick="return confirm('Confirm return pickup from customer? (Free — no wallet charge)');">
                                <i class="fa fa-hand-paper-o"/> MARK RETURN PICKED
                            </button>
                        </form>
                    </t>

                    <!-- Same-district skip-hub: after pickup go directly OFD -->
                    <t t-if="can_skip_hub">
                        <hr/>
                        <h4 class="mb-3 text-success">
                            <i class="fa fa-bolt"/> Local Delivery (Same District)
                        </h4>
                        <p class="text-muted small mb-3">
                            Source and destination share the same hub. You can skip hub inventory
                            and go directly out for delivery.
                        </p>
                        <form t-attf-action="/my/delivery/#{shipment.id}/skip_hub" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="scanned_code" t-att-value="shipment.name"/>
                            <button type="submit" class="btn btn-lg btn-success w-100 fw-bold shadow-sm"
                                    onclick="return confirm('Deliver locally and skip hub inventory?');">
                                <i class="fa fa-motorcycle"/> Deliver Locally (Skip Hub)
                            </button>
                        </form>
                    </t>

                    <!-- Hub-transfer actions while DE holds the package -->
                    <t t-if="shipment.custodian_type == 'de' and is_hub_transfer and shipment.state in ['picked', 'return_picked', 'in_transit', 'at_central_hub']">
                        <hr/>
                        <h4 class="mb-3 text-info">
                            <i class="fa fa-truck"/> Hub Transfer
                            <small class="text-muted ms-2" t-if="active_leg_label"><t t-esc="active_leg_label"/></small>
                        </h4>
                        <p class="text-muted small mb-3">
                            After claim/dispatch you hold the package. Depart the source hub if still there,
                            optionally record a Thrissur pass-through if you physically go via the main hub,
                            then drop at the destination hub for hub-manager receive.
                        </p>

                        <t t-if="can_depart_hub">
                            <form t-attf-action="/my/delivery/#{shipment.id}/depart_hub" method="post" class="mb-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-outline-primary w-100"
                                        onclick="return confirm('Confirm departure from source hub?');">
                                    <i class="fa fa-sign-out"/> Depart from Hub
                                </button>
                            </form>
                        </t>

                        <t t-if="can_pass_through">
                            <h5 class="mb-2 text-secondary">Thrissur Pass-Through</h5>
                            <p class="text-muted small">Scan the AWB QR to record optional physical pass-through at the main hub. Package stays In Transit.</p>
                            <form t-attf-action="/my/delivery/#{shipment.id}/pass_through" method="post" class="mb-3" id="pass_through_form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="scanned_code" id="pass_through_scanned_code" value=""/>
                                <button type="button"
                                        class="btn btn-outline-secondary w-100 btn-scan-qr"
                                        data-scan-target="#pass_through_scanned_code"
                                        data-scan-auto-submit="1">
                                    <i class="fa fa-qrcode"/> Scan AWB &amp; Record Thrissur Pass-Through
                                </button>
                            </form>
                        </t>

                        <h5 class="mb-2 text-warning">Arrive / Drop at Destination Hub</h5>
                        <p class="text-muted small">Signals drop intent. Destination hub manager must Receive to take custody.</p>
                        <form t-attf-action="/my/delivery/#{shipment.id}/drop_at_hub" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="col-md-8">
                                <label class="form-label">Hub</label>
                                <select name="hub_id" class="form-select" required="1">
                                    <t t-foreach="hubs" t-as="hub">
                                        <option t-att-value="hub.id"
                                                t-att-selected="preferred_drop_hub and hub.id == preferred_drop_hub.id">
                                            <t t-esc="hub.name"/>
                                            <t t-if="hub.code"> (<t t-esc="hub.code"/>)</t>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="fa fa-building"/> Drop at Hub
                                </button>
                            </div>
                        </form>
                    </t>

                    <!-- Pickup / general drop (non transfer) -->
                    <t t-if="shipment.custodian_type == 'de' and shipment.state in ['picked', 'return_picked', 'in_transit'] and not is_hub_transfer">
                        <hr/>
                        <h4 class="mb-3 text-warning">Drop at Hub</h4>
                        <p class="text-muted small">Marks package as dropped. Hub manager receive scan is required to transfer custody to the hub.</p>
                        <form t-attf-action="/my/delivery/#{shipment.id}/drop_at_hub" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="col-md-8">
                                <label class="form-label">Hub</label>
                                <select name="hub_id" class="form-select" required="1">
                                    <t t-foreach="hubs" t-as="hub">
                                        <option t-att-value="hub.id"
                                                t-att-selected="preferred_drop_hub and hub.id == preferred_drop_hub.id">
                                            <t t-esc="hub.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="fa fa-building"/> Drop at Hub
                                </button>
                            </div>
                        </form>
                    </t>

                    <t t-if="shipment.state == 'out_for_delivery'">
                        <hr/>
                        <h4 class="mb-3 text-primary">
                            <t t-if="shipment.is_return_journey">Mark Returned to Seller</t>
                            <t t-else="">Mark as Delivered</t>
                        </h4>
                        <form t-attf-action="/my/delivery/#{shipment.id}/mark_delivered" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <t t-if="shipment.is_return_journey">
                                <div class="alert alert-success mb-3">
                                    Free return completion — deliver package to the seller. No wallet deduction. No COD collection.
                                </div>
                            </t>
                            <t t-elif="shipment.order_payment_type == 'cod'">
                                <div class="mb-4 p-3 border rounded bg-light">
                                    <h5 class="mb-3">Collect COD Payment: <span t-field="shipment.cod_amount"/></h5>
                                    
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" name="cod_payment_method" id="codCash" value="cash" required="1" checked="1"/>
                                        <label class="form-check-label fw-bold" for="codCash">
                                            <i class="fa fa-money text-success"/> Cash Collected
                                        </label>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" type="radio" name="cod_payment_method" id="codUPI" value="upi" required="1"/>
                                        <label class="form-check-label fw-bold" for="codUPI">
                                            <i class="fa fa-qrcode text-primary"/> UPI Payment
                                        </label>
                                    </div>

                                </div>
                            </t>
                            <div class="mb-4 p-3 border rounded bg-light">
                                    <h5 class="mb-3">
                                        <t t-if="shipment.is_return_journey">Return Remarks</t>
                                        <t t-else="">Delivery Remarks</t>
                                    </h5>
                                    <div class="form-input p-2 mb-2 row">
                                        <textarea class="form-input" rows="5" type="text" name="delivery_remarks" id="deliveryRemarks"/>
                                    </div>
                            </div>

                            <t t-if="shipment.is_return_journey">
                                <button type="submit" class="btn btn-lg btn-success w-100 fw-bold shadow-sm"
                                        onclick="return confirm('Confirm package returned to seller? (Free — no wallet charge)');">
                                    <i class="fa fa-check-circle"/> MARK RETURNED TO SELLER
                                </button>
                            </t>
                            <t t-else="">
                                <button type="submit" class="btn btn-lg btn-success w-100 fw-bold shadow-sm" onclick="return confirm('Are you sure you want to mark this shipment as DELIVERED? This action cannot be undone.');">
                                    <i class="fa fa-check-circle"/> MARK AS DELIVERED
                                </button>
                            </t>
                        </form>
                    </t>

                    <t t-call="keralariders_logistics.shipment_tracking_timeline">
                        <t t-set="timeline_events" t-value="tracking_events"/>
                    </t>
                </div>
            </div>
            <t t-call="keralariders_logistics.portal_qr_scanner_modal"/>
        </t>
    </template>

    <!-- Self-assign / Claim at hub -->
    <template id="portal_my_delivery_claim" name="Claim Shipment">
        <t t-call="portal.portal_layout">
            <div class="card shadow-sm mb-4" style="max-width:640px;margin:0 auto;">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="fa fa-hand-rock-o me-2"/> Claim Package — <t t-esc="shipment.name"/></h4>
                </div>
                <div class="card-body">
                    <t t-if="error">
                        <div class="alert alert-danger" role="alert"><t t-esc="error"/></div>
                    </t>
                    <t t-if="success">
                        <div class="alert alert-success" role="alert"><t t-esc="success"/></div>
                    </t>

                    <p class="mb-3">This package is in hub custody and ready for the next hop. Claiming transfers custody to you.</p>

                    <div class="mb-3 p-3 border rounded bg-light">
                        <p class="mb-1"><strong>Hub:</strong> <t t-esc="shipment.current_hub_id.name"/></p>
                        <p class="mb-1"><strong>Status:</strong>
                            <t t-esc="dict(shipment.fields_get(allfields=['state'])['state']['selection'])[shipment.state]"/>
                        </p>
                        <p class="mb-1"><strong>To:</strong> <t t-esc="shipment.shipping_to_name"/> —
                            <t t-esc="shipment.shipping_to_zip"/>
                        </p>
                        <t t-if="leg">
                            <p class="mb-1"><strong>Next leg:</strong>
                                <t t-if="leg.operation_type == 'hub_transfer'">
                                    Hub transfer:
                                    <t t-if="leg.from_hub_id"><t t-esc="leg.from_hub_id.code or leg.from_hub_id.name"/></t>
                                    <t t-else="">?</t>
                                    →
                                    <t t-if="leg.to_hub_id"><t t-esc="leg.to_hub_id.code or leg.to_hub_id.name"/></t>
                                    <t t-else="">?</t>
                                </t>
                                <t t-else="">
                                    <t t-esc="leg.name"/>
                                </t>
                            </p>
                            <p class="mb-0"><strong>Operation:</strong>
                                <span class="badge text-bg-info"><t t-esc="leg.operation_type"/></span>
                            </p>
                        </t>
                    </div>

                    <form t-attf-action="/my/delivery/#{shipment.id}/claim" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="scanned_code" t-att-value="shipment.name"/>
                        <button type="submit" class="btn btn-lg btn-success w-100 fw-bold shadow-sm mb-2"
                                onclick="return confirm('Claim this package and take custody?');">
                            <i class="fa fa-check"/> Claim &amp; Take Custody
                        </button>
                    </form>
                    <a t-attf-href="/my/delivery/#{shipment.id}?view=1" class="btn btn-link w-100">View details instead</a>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_cod_deposit" name="COD Hub Deposit">
        <t t-call="portal.portal_layout">
            <div class="container py-3" style="max-width: 720px;">
                <a href="/my" class="btn btn-link ps-0 mb-2"><i class="fa fa-arrow-left"/> Back</a>
                <h3 class="mb-3">Deposit COD Cash at Hub</h3>
                <p class="text-muted">
                    Transfer COD cash from your DE cash account to the selected hub.
                    Hub managers later bank these deposits to the company account.
                </p>
                <t t-if="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>
                <t t-if="success">
                    <div class="alert alert-success"><t t-esc="success"/></div>
                </t>
                <div class="alert alert-info">
                    Cash account:
                    <strong><t t-esc="cash_account.name if cash_account else 'Not configured'"/></strong>
                    · Undeposited total:
                    <strong><t t-esc="'%.2f' % undeposited_total"/></strong>
                </div>
                <t t-if="not undeposited">
                    <p class="alert alert-secondary">No undeposited COD cash payments in your account.</p>
                </t>
                <t t-else="">
                    <form action="/my/cod_deposit" method="post" class="card shadow-sm p-4">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label class="form-label">Deposit at Hub</label>
                            <select name="hub_id" class="form-select" required="1">
                                <t t-foreach="hubs" t-as="hub">
                                    <option t-att-value="hub.id"><t t-esc="hub.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Ref</th>
                                        <th>Date</th>
                                        <th>AWB / Seller</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="undeposited" t-as="pay">
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="payment_ids" t-att-value="pay.id" checked="1"/>
                                            </td>
                                            <td><t t-esc="pay.name"/></td>
                                            <td><t t-esc="pay.transfer_date"/></td>
                                            <td>
                                                <t t-esc="pay.shipment_id.name or ''"/>
                                                <t t-if="pay.related_seller_id">
                                                    <br/><small class="text-muted"><t t-esc="pay.related_seller_id.name"/></small>
                                                </t>
                                            </td>
                                            <td class="text-end"><t t-esc="'%.2f' % pay.amount"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Note (optional)</label>
                            <input type="text" name="note" class="form-control" placeholder="Deposit slip / remarks"/>
                        </div>
                        <button type="submit" class="btn btn-primary w-100"
                                onclick="return confirm('Confirm COD cash deposit at the selected hub?');">
                            <i class="fa fa-building"/> Deposit Selected at Hub
                        </button>
                    </form>
                </t>
            </div>
        </t>
    </template>
</odoo>
