<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_delivery_executive_wizard_form" model="ir.ui.view">
        <field name="name">logistics.assign.delivery.executive.wizard.form</field>
        <field name="model">logistics.assign.delivery.executive.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Delivery Executive">
                <group>
                    <field name="delivery_executive_id"/>
                </group>
                <footer>
                    <button string="Assign" name="action_assign" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assign_delivery_executive_wizard" model="ir.actions.act_window">
        <field name="name">Assign Delivery Executive</field>
        <field name="res_model">logistics.assign.delivery.executive.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_logistics_shipment"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
