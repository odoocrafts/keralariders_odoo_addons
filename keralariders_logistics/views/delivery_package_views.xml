<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Delivery Package Tree View -->
    <record id="view_logistics_delivery_package_tree" model="ir.ui.view">
        <field name="name">logistics.delivery.package.tree</field>
        <field name="model">logistics.delivery.package</field>
        <field name="arch" type="xml">
            <list string="Delivery Packages">
                <field name="name"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <!-- Delivery Package Form View -->
    <record id="view_logistics_delivery_package_form" model="ir.ui.view">
        <field name="name">logistics.delivery.package.form</field>
        <field name="model">logistics.delivery.package</field>
        <field name="arch" type="xml">
            <form string="Delivery Package">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Package Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="is_default" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page string="Charge Slabs" name="charge_slabs">
                            <field name="charge_ids">
                                <list string="Slabs">
                                    <field name="name"/>
                                    <field name="minimum_weight"/>
                                    <field name="maximum_weight"/>
                                    <field name="same_district_amount"/>
                                    <field name="different_district_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Delivery Package Action -->
    <record id="action_logistics_delivery_package" model="ir.actions.act_window">
        <field name="name">Delivery Packages</field>
        <field name="res_model">logistics.delivery.package</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Delivery Package
            </p>
            <p>
                Delivery packages allow you to set custom pricing rates for different sellers.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_logistics_delivery_package"
              name="Delivery Packages"
              parent="menu_logistics_root"
              action="action_logistics_delivery_package"
              sequence="65"/>

</odoo>
