<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Replace "Powered by Odoo" on the Login Page -->
    <template id="login_layout_odoocrafts" inherit_id="web.login_layout" priority="99">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a href="https://odoocrafts.com" target="_blank">Powered by <span>Odoocrafts</span></a>
        </xpath>
    </template>

    <!-- Replace "Powered by Odoo" in the Portal Footer -->
    <template id="portal_footer_odoocrafts" inherit_id="portal.frontend_layout" priority="99">
        <xpath expr="//div[hasclass('o_footer_copyright_name')]/../div[last()]" position="replace">
            <div class="col-sm-6 text-sm-end">
                Powered by <a target="_blank" href="https://odoocrafts.com">Odoocrafts</a>
            </div>
        </xpath>
    </template>
</odoo>
