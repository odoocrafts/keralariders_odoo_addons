<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tracking_search_page" name="Shipment Tracking Search">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
                <style>
                    body {
                        background-color: #f8f9fa;
                    }
                    .tracking-card {
                        border-radius: 1rem;
                        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                        overflow: hidden;
                        border: none;
                    }
                    .tracking-header {
                        background: linear-gradient(135deg, #1f2937, #374151);
                        padding: 2.5rem 1.5rem;
                        border-bottom: none;
                    }
                    .company-logo {
                        max-height: 80px;
                        max-width: 100%;
                        margin-bottom: 1.5rem;
                        background: rgba(255,255,255,0.95);
                        padding: 10px 15px;
                        border-radius: 8px;
                        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                    }
                    .btn-track {
                        background-color: #1f2937;
                        border-color: #1f2937;
                        padding: 0.75rem;
                        font-weight: 600;
                        letter-spacing: 0.5px;
                        transition: all 0.3s ease;
                    }
                    .btn-track:hover {
                        background-color: #374151;
                        border-color: #374151;
                        transform: translateY(-2px);
                        box-shadow: 0 4px 12px rgba(55, 65, 81, 0.3);
                    }
                    .form-control-lg {
                        border-radius: 0.5rem;
                        padding: 1rem 1.25rem;
                        font-size: 1.1rem;
                        border: 2px solid #e5e7eb;
                    }
                    .form-control-lg:focus {
                        border-color: #374151;
                        box-shadow: 0 0 0 0.25rem rgba(31, 41, 55, 0.15);
                    }
                </style>
            </t>
            <t t-set="title">Track Your Shipment</t>
            <div class="container mt-3 mt-md-5 mb-5">
                <div class="row justify-content-center align-items-center" style="min-height: 75vh;">
                    <div class="col-md-8 col-lg-5">
                        <div class="card tracking-card">
                            <div class="card-header tracking-header text-white text-center">
                                <t t-if="company and company.logo">
                                    <img t-attf-src="/web/image/res.company/#{company.id}/logo" alt="Company Logo" class="company-logo"/>
                                </t>
                                <h2 class="mb-0 fw-bold">Track Shipment</h2>
                                <p class="text-light mt-2 mb-0" style="opacity: 0.85;">Enter your AWB number below</p>
                            </div>
                            <div class="card-body p-4 p-md-5">
                                <t t-if="error">
                                    <div class="alert alert-danger shadow-sm border-0" role="alert">
                                        <i class="fa fa-exclamation-triangle me-2"></i>
                                        <t t-esc="error"/>
                                    </div>
                                </t>
                                <form action="/track" method="post">
                                    <div class="mb-4">
                                        <label for="awb" class="form-label fw-bold text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">AWB Number</label>
                                        <input type="text" class="form-control form-control-lg bg-light" id="awb" name="awb" placeholder="e.g. SHP00001" required="1" autofocus="autofocus"/>
                                    </div>
                                    <button type="submit" class="btn btn-track btn-primary btn-lg w-100 text-white rounded-3 shadow-sm">
                                        <i class="fa fa-search me-2"></i> Track Now
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="tracking_page" name="Shipment Tracking">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </t>
            <t t-set="title">Track Shipment <t t-esc="shipment.name"/></t>
            <div class="container mt-3 mt-md-5 mb-5">
                <div class="card shadow-sm border-0 rounded">
                    <div class="card-header bg-primary text-white text-center py-4">
                        <h2 class="mb-0">Shipment Tracking</h2>
                        <p class="mb-0 mt-2">AWB: <strong><t t-esc="shipment.name"/></strong></p>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h5>Status</h5>
                                <h3 class="text-info"><t t-esc="shipment_state_str"/></h3>
                            </div>
                            <div class="col-md-6 text-md-end text-md-right">
                                <h5>Estimated Delivery</h5>
                                <h4 class="text-success">
                                    <t t-if="shipment.estimated_delivery_date">
                                        <t t-esc="shipment.estimated_delivery_date"/>
                                    </t>
                                    <t t-else="">
                                        Pending
                                    </t>
                                </h4>
                            </div>
                        </div>
                        <hr/>
                        <div class="row mt-4">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted text-uppercase font-weight-bold">Origin</h6>
                                <p class="mb-0">
                                    <t t-if="shipment.shipping_from_district_id"><t t-esc="shipment.shipping_from_district_id.name"/>, </t>
                                    <t t-if="shipment.shipping_from_state_id"><t t-esc="shipment.shipping_from_state_id.name"/></t>
                                </p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted text-uppercase font-weight-bold">Destination</h6>
                                <p class="mb-0">
                                    <t t-if="shipment.shipping_to_district_id"><t t-esc="shipment.shipping_to_district_id.name"/>, </t>
                                    <t t-if="shipment.shipping_to_state_id"><t t-esc="shipment.shipping_to_state_id.name"/></t>
                                </p>
                            </div>
                        </div>

                        <t t-call="keralariders_logistics.shipment_tracking_timeline">
                            <t t-set="timeline_events" t-value="tracking_events"/>
                            <t t-set="timeline_event_labels" t-value="event_type_labels"/>
                        </t>
                        
                        <t t-if="shipment.state == 'delivered'">
                            <div class="alert alert-success mt-4 text-center">
                                <i class="fa fa-check-circle fa-2x mb-2"></i>
                                <h5>This shipment was successfully delivered.</h5>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Shared custody/event timeline for public track + DE portal -->
    <template id="shipment_tracking_timeline" name="Shipment Tracking Timeline">
        <t t-if="timeline_events">
            <hr class="mt-4"/>
            <h5 class="mb-3">Tracking History</h5>
            <ul class="list-unstyled mb-0" style="border-left:3px solid #e5e7eb;padding-left:1.25rem;">
                <t t-foreach="timeline_events" t-as="event">
                    <li class="mb-3 position-relative" style="margin-left:0.25rem;">
                        <span style="position:absolute;left:-1.55rem;top:0.35rem;width:10px;height:10px;border-radius:50%;background:#374151;border:2px solid #fff;box-shadow:0 0 0 2px #d1d5db;"></span>
                        <div class="fw-semibold">
                            <t t-esc="(timeline_event_labels or {}).get(event.event_type, event.event_type)"/>
                        </div>
                        <div class="text-muted small">
                            <t t-esc="event.event_time"/>
                        </div>
                        <t t-set="detail" t-value="event.get_timeline_detail()"/>
                        <div t-if="detail" class="small mt-1"><t t-esc="detail"/></div>
                    </li>
                </t>
            </ul>
        </t>
        <t t-else="">
            <hr class="mt-4"/>
            <p class="text-muted mb-0">No tracking events yet.</p>
        </t>
    </template>
</odoo>
