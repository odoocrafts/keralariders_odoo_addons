<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tracking_search_page" name="Shipment Tracking Search">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
                <style>
                    body {
                        background-color: #f3f4f6;
                    }
                    .tracking-card {
                        border-radius: 1rem;
                        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                        overflow: hidden;
                        border: none;
                    }
                    .tracking-header {
                        background: linear-gradient(135deg, #1f2937, #374151);
                        padding: 2.5rem 1.5rem;
                        border-bottom: none;
                    }
                    .company-logo {
                        max-height: 80px;
                        max-width: 100%;
                        margin-bottom: 1.5rem;
                        background: rgba(255,255,255,0.95);
                        padding: 10px 15px;
                        border-radius: 8px;
                        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                    }
                    .btn-track {
                        background-color: #1f2937;
                        border-color: #1f2937;
                        padding: 0.75rem;
                        font-weight: 600;
                        letter-spacing: 0.5px;
                        transition: all 0.3s ease;
                    }
                    .btn-track:hover {
                        background-color: #374151;
                        border-color: #374151;
                        transform: translateY(-2px);
                        box-shadow: 0 4px 12px rgba(55, 65, 81, 0.3);
                    }
                    .form-control-lg {
                        border-radius: 0.5rem;
                        padding: 1rem 1.25rem;
                        font-size: 1.1rem;
                        border: 2px solid #e5e7eb;
                    }
                    .form-control-lg:focus {
                        border-color: #374151;
                        box-shadow: 0 0 0 0.25rem rgba(31, 41, 55, 0.15);
                    }
                </style>
            </t>
            <t t-set="title">Track Your Shipment</t>
            <div class="container mt-3 mt-md-5 mb-5">
                <div class="row justify-content-center align-items-center" style="min-height: 75vh;">
                    <div class="col-md-8 col-lg-5">
                        <div class="card tracking-card">
                            <div class="card-header tracking-header text-white text-center">
                                <t t-if="company and company.logo">
                                    <img t-attf-src="/web/image/res.company/#{company.id}/logo" alt="Company Logo" class="company-logo"/>
                                </t>
                                <h2 class="mb-0 fw-bold">Track Shipment</h2>
                                <p class="text-light mt-2 mb-0" style="opacity: 0.85;">Enter your AWB number below</p>
                            </div>
                            <div class="card-body p-4 p-md-5">
                                <t t-if="error">
                                    <div class="alert alert-danger shadow-sm border-0" role="alert">
                                        <i class="fa fa-exclamation-triangle me-2"></i>
                                        <t t-esc="error"/>
                                    </div>
                                </t>
                                <form action="/track" method="post">
                                    <div class="mb-4">
                                        <label for="awb" class="form-label fw-bold text-muted text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">AWB Number</label>
                                        <input type="text" class="form-control form-control-lg bg-light" id="awb" name="awb" placeholder="e.g. SHP00001" required="1" autofocus="autofocus"/>
                                    </div>
                                    <button type="submit" class="btn btn-track btn-primary btn-lg w-100 text-white rounded-3 shadow-sm">
                                        <i class="fa fa-search me-2"></i> Track Now
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="tracking_page" name="Shipment Tracking">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
                <style>
                    body { background-color: #f3f4f6; }
                    .kx-track-card {
                        border: none;
                        border-radius: 1rem;
                        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                        overflow: hidden;
                    }
                    .kx-track-header {
                        background: linear-gradient(135deg, #1f2937, #374151);
                        color: #fff;
                        padding: 1.75rem 1.25rem;
                        text-align: center;
                    }
                    .kx-track-header .company-logo {
                        max-height: 56px;
                        max-width: 100%;
                        margin-bottom: 0.75rem;
                        background: rgba(255,255,255,0.95);
                        padding: 6px 12px;
                        border-radius: 8px;
                    }
                    .kx-status-badge {
                        display: inline-block;
                        padding: 0.35rem 0.9rem;
                        border-radius: 999px;
                        font-weight: 700;
                        font-size: 0.95rem;
                        letter-spacing: 0.02em;
                        background: rgba(255,255,255,0.15);
                        color: #fff;
                    }
                    .kx-status-badge.is-delivered {
                        background: #059669;
                        color: #fff;
                    }
                    .kx-status-badge.is-ofd {
                        background: #d97706;
                        color: #fff;
                    }
                    .kx-status-badge.is-cancelled {
                        background: #dc2626;
                        color: #fff;
                    }
                    .kx-meta-label {
                        font-size: 0.75rem;
                        text-transform: uppercase;
                        letter-spacing: 0.06em;
                        color: #6b7280;
                        font-weight: 700;
                        margin-bottom: 0.25rem;
                    }
                    .kx-meta-value {
                        font-size: 1.05rem;
                        color: #111827;
                        font-weight: 600;
                        margin-bottom: 0;
                    }
                    .kx-meta-value.muted { color: #9ca3af; font-weight: 500; }
                    .kx-route-row {
                        background: #f9fafb;
                        border-radius: 0.75rem;
                        padding: 1rem 1.1rem;
                    }
                    .kx-event-list {
                        list-style: none;
                        padding: 0;
                        margin: 0;
                        border-left: 3px solid #e5e7eb;
                        padding-left: 1.25rem;
                    }
                    .kx-event-item {
                        position: relative;
                        margin-bottom: 1rem;
                    }
                    .kx-event-item:last-child { margin-bottom: 0; }
                    .kx-event-item::before {
                        content: '';
                        position: absolute;
                        left: -1.55rem;
                        top: 0.4rem;
                        width: 10px;
                        height: 10px;
                        border-radius: 50%;
                        background: #374151;
                        border: 2px solid #fff;
                        box-shadow: 0 0 0 2px #d1d5db;
                    }
                    .kx-event-item.is-delivered::before {
                        background: #059669;
                        box-shadow: 0 0 0 2px #a7f3d0;
                    }
                    .kx-facts {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 0.75rem 1.25rem;
                        font-size: 0.9rem;
                        color: #4b5563;
                    }
                    .kx-facts strong { color: #111827; }
                    .kx-delivered-banner {
                        background: #ecfdf5;
                        border: 1px solid #a7f3d0;
                        color: #065f46;
                        border-radius: 0.75rem;
                        padding: 1rem;
                        text-align: center;
                    }
                </style>
            </t>
            <t t-set="title">Track Shipment <t t-esc="shipment.name"/></t>
            <div class="container mt-3 mt-md-4 mb-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8 col-xl-7">
                        <div class="card kx-track-card">
                            <div class="kx-track-header">
                                <t t-if="company and company.logo">
                                    <img t-attf-src="/web/image/res.company/#{company.id}/logo" alt="Company Logo" class="company-logo"/>
                                </t>
                                <p class="mb-1 text-white-50 small text-uppercase" style="letter-spacing:0.08em;opacity:0.8;">Shipment Tracking</p>
                                <h2 class="mb-2 fw-bold" style="font-size:1.35rem;">AWB <t t-esc="shipment.name"/></h2>
                                <span t-attf-class="kx-status-badge #{'is-delivered' if shipment.state == 'delivered' else 'is-ofd' if shipment.state == 'out_for_delivery' else 'is-cancelled' if shipment.state in ('cancelled', 'returned', 'delivery_failed') else ''}">
                                    <t t-esc="shipment_state_str"/>
                                </span>
                            </div>

                            <div class="card-body p-4">
                                <!-- Status + delivery date -->
                                <div class="row g-3 mb-3">
                                    <div class="col-sm-6">
                                        <div class="kx-meta-label">Status</div>
                                        <p class="kx-meta-value"><t t-esc="shipment_state_str"/></p>
                                    </div>
                                    <div class="col-sm-6 text-sm-end">
                                        <div class="kx-meta-label"><t t-esc="delivery_display.get('label')"/></div>
                                        <t t-if="delivery_display.get('value')">
                                            <p t-att-class="'kx-meta-value text-success' if delivery_display.get('is_delivered') else 'kx-meta-value'">
                                                <t t-esc="delivery_display.get('value')"/>
                                            </p>
                                        </t>
                                        <t t-else="">
                                            <p class="kx-meta-value muted">—</p>
                                        </t>
                                    </div>
                                </div>

                                <!-- Origin / Destination -->
                                <div class="kx-route-row mb-4">
                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <div class="kx-meta-label">Origin</div>
                                            <p class="kx-meta-value"><t t-esc="origin_label"/></p>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="kx-meta-label">Destination</div>
                                            <p class="kx-meta-value"><t t-esc="destination_label"/></p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Final-mile delivery contact (OFD / delivered only) -->
                                <t t-if="delivery_contact_phone">
                                    <div class="mb-4 p-3 rounded" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                                        <div class="kx-meta-label mb-1">Delivery contact</div>
                                        <p class="kx-meta-value mb-0">
                                            <a t-att-href="'tel:' + delivery_contact_phone" class="text-decoration-none fw-semibold" style="color:#166534;">
                                                <i class="fa fa-phone me-1"/>
                                                <t t-esc="delivery_contact_phone"/>
                                            </a>
                                        </p>
                                    </div>
                                </t>

                                <!-- Optional facts -->
                                <div class="kx-facts mb-4">
                                    <t t-if="weight_display">
                                        <span>Weight: <strong><t t-esc="weight_display"/></strong></span>
                                    </t>
                                    <t t-if="payment_type_label and shipment.order_payment_type != 'na'">
                                        <span>Payment: <strong><t t-esc="payment_type_label"/></strong></span>
                                    </t>
                                    <t t-if="shipment.delivery_duration_display">
                                        <span>Time to deliver: <strong><t t-esc="shipment.delivery_duration_display"/></strong></span>
                                    </t>
                                    <t t-if="last_update_display">
                                        <span>Updated: <strong><t t-esc="last_update_display"/></strong></span>
                                    </t>
                                </div>

                                <!-- Event timeline (Tracking History) -->
                                <t t-call="keralariders_logistics.shipment_tracking_timeline">
                                    <t t-set="timeline_events" t-value="tracking_events"/>
                                </t>

                                <t t-if="shipment.state == 'delivered'">
                                    <div class="kx-delivered-banner mt-4">
                                        <i class="fa fa-check-circle fa-lg mb-2 d-block"/>
                                        <strong>This shipment was successfully delivered.</strong>
                                        <t t-if="delivery_display.get('value')">
                                            <div class="small mt-1"><t t-esc="delivery_display.get('value')"/></div>
                                        </t>
                                    </div>
                                </t>

                                <div class="text-center mt-4">
                                    <a href="/track" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-search me-1"/> Track another shipment
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Shared custody/event timeline for public track + DE portal (expects list of dicts) -->
    <template id="shipment_tracking_timeline" name="Shipment Tracking Timeline">
        <t t-if="timeline_events">
            <hr class="mt-2"/>
            <h5 class="mb-3" style="font-weight:700;">Tracking History</h5>
            <ul class="list-unstyled mb-0" style="border-left:3px solid #e5e7eb;padding-left:1.25rem;">
                <t t-foreach="timeline_events" t-as="event">
                    <li class="mb-3 position-relative" style="margin-left:0.25rem;">
                        <span style="position:absolute;left:-1.55rem;top:0.35rem;width:10px;height:10px;border-radius:50%;background:#374151;border:2px solid #fff;box-shadow:0 0 0 2px #d1d5db;"/>
                        <div class="fw-semibold">
                            <t t-esc="event.get('label')"/>
                        </div>
                        <div class="text-muted small">
                            <t t-esc="event.get('time_display') or ''"/>
                        </div>
                        <t t-if="event.get('detail')">
                            <div class="small mt-1 text-secondary"><t t-esc="event.get('detail')"/></div>
                        </t>
                    </li>
                </t>
            </ul>
        </t>
        <t t-else="">
            <hr class="mt-2"/>
            <p class="text-muted mb-0">No tracking events yet.</p>
        </t>
    </template>
</odoo>
