<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kx_invoice_generate_wizard_form" model="ir.ui.view">
        <field name="name">kx.invoice.generate.wizard.form</field>
        <field name="model">kx.invoice.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Seller Invoices">
                <p class="text-muted">
                    Each invoice bills the services a seller used in the month (shipment
                    charges and additional charges, less refunds), with GST included.
                    Sellers that already have an invoice for the month are skipped unless
                    you choose to replace it.
                </p>
                <group>
                    <group>
                        <field name="month"/>
                        <field name="year" options="{'format': false}"/>
                    </group>
                    <group>
                        <field name="seller_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="post"/>
                        <field name="regenerate"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kx_invoice_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Invoices</field>
        <field name="res_model">kx.invoice.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
