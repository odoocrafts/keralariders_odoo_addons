<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kx_ledger_statement_wizard_form" model="ir.ui.view">
        <field name="name">kx.ledger.statement.wizard.form</field>
        <field name="model">kx.ledger.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Ledger Statement">
                <group>
                    <group>
                        <field name="seller_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="source"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Download PDF" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Download Excel"/>
                    <button name="action_view_lines" type="object" string="View Lines"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kx_ledger_statement_wizard" model="ir.actions.act_window">
        <field name="name">Ledger Statement</field>
        <field name="res_model">kx.ledger.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
