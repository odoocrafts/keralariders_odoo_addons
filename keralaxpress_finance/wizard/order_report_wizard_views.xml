<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kx_order_report_wizard_form" model="ir.ui.view">
        <field name="name">kx.order.report.wizard.form</field>
        <field name="model">kx.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Order Report">
                <p class="text-muted">
                    Every booked shipment counts as one customer order. The workbook has
                    a summary, the status summary, seller-wise statistics and the order list.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="seller_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="state_filter"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Download Excel" class="btn-primary"/>
                    <button name="action_open_analysis" type="object" string="Open Analysis"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kx_order_report_wizard" model="ir.actions.act_window">
        <field name="name">Order Report</field>
        <field name="res_model">kx.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
