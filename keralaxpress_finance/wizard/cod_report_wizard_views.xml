<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kx_cod_report_wizard_form" model="ir.ui.view">
        <field name="name">kx.cod.report.wizard.form</field>
        <field name="model">kx.cod.report.wizard</field>
        <field name="arch" type="xml">
            <form string="COD Wallet Report">
                <p class="text-muted">
                    Total and seller-wise COD balance as of the end date, the date-wise
                    balance and every COD transaction in the period.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="seller_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Download Excel" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kx_cod_report_wizard" model="ir.actions.act_window">
        <field name="name">COD Wallet Report</field>
        <field name="res_model">kx.cod.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
