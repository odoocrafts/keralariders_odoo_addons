<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Order analysis: one shipment is one customer order. These views are
         new and only used by the Reports menu; the shipment views of
         keralariders_logistics are not touched. -->
    <record id="view_kx_order_analysis_list" model="ir.ui.view">
        <field name="name">kx.order.analysis.list</field>
        <field name="model">logistics.shipment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Orders" create="false" edit="false" delete="false">
                <field name="order_date"/>
                <field name="name"/>
                <field name="order_id" optional="show"/>
                <field name="seller_id"/>
                <field name="shipping_to_name" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="order_payment_type" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_order_value" sum="Total"/>
                <field name="cod_amount" sum="Total" optional="show"/>
                <field name="delivery_charges_total" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_kx_order_analysis_pivot" model="ir.ui.view">
        <field name="name">kx.order.analysis.pivot</field>
        <field name="model">logistics.shipment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <pivot string="Order Analysis" sample="1">
                <field name="seller_id" type="row"/>
                <field name="state" type="col"/>
                <field name="total_order_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kx_order_analysis_graph" model="ir.ui.view">
        <field name="name">kx.order.analysis.graph</field>
        <field name="model">logistics.shipment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <graph string="Order Analysis" type="bar" sample="1">
                <field name="order_date" interval="day"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_kx_order_analysis_search" model="ir.ui.view">
        <field name="name">kx.order.analysis.search</field>
        <field name="model">logistics.shipment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Order Analysis">
                <field name="name"/>
                <field name="seller_id"/>
                <field name="order_id"/>
                <field name="state"/>
                <filter name="filter_order_date" string="Order Date" date="order_date"/>
                <separator/>
                <filter name="delivered" string="Delivered" domain="[('state', '=', 'delivered')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter name="in_progress" string="In Progress"
                        domain="[('state', 'not in', ('delivered', 'cancelled', 'returned'))]"/>
                <filter name="returns" string="Returns"
                        domain="[('state', 'in', ('return_requested', 'return_picked', 'returned'))]"/>
                <separator/>
                <filter name="cod" string="COD" domain="[('order_payment_type', '=', 'cod')]"/>
                <filter name="prepaid" string="Prepaid" domain="[('order_payment_type', '=', 'prepaid')]"/>
                <group>
                    <filter name="group_seller" string="Seller" context="{'group_by': 'seller_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_payment" string="Payment Type" context="{'group_by': 'order_payment_type'}"/>
                    <filter name="group_day" string="Order Date" context="{'group_by': 'order_date:day'}"/>
                    <filter name="group_month" string="Order Month" context="{'group_by': 'order_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kx_order_analysis" model="ir.actions.act_window">
        <field name="name">Order Analysis</field>
        <field name="res_model">logistics.shipment</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_kx_order_analysis_search"/>
        <field name="domain">[('state', '!=', 'order_added'), '|', ('order_id', '=', False), ('order_id.state', '!=', 'draft')]</field>
        <field name="context">{'search_default_filter_order_date': 1, 'create': False, 'edit': False, 'delete': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_kx_order_analysis_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_kx_order_analysis_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kx_order_analysis_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No booked orders yet</p>
            <p>Every booked shipment counts as one customer order.</p>
        </field>
    </record>
</odoo>
