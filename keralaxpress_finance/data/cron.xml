<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_generate_monthly_seller_invoices" model="ir.cron">
            <field name="name">KeralaXpress: generate last month's seller invoices</field>
            <field name="model_id" ref="model_kx_seller_invoice"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_previous_month()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1, hour=1, minute=0, second=0) + relativedelta(months=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
