<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_kx_seller_invoice" model="ir.sequence">
            <field name="name">KeralaXpress Seller Invoice</field>
            <field name="code">kx.seller.invoice</field>
            <field name="prefix">KXINV/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="False"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_kx_expense" model="ir.sequence">
            <field name="name">KeralaXpress Expense</field>
            <field name="code">kx.expense</field>
            <field name="prefix">EXP/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
